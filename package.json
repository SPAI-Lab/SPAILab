{
  "name": "lab-spai",
  "type": "module",
  "version": "1.0.0",
  "description": "SP&AI lab website (Astro + SCSS), based on the Scholar-Lite template.",
  "license": "MIT",
  "author": "SP&AI Lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPAI-Lab/SPAILab.git"
  },
