---
// Minimal typography for rendered markdown (<Content />).
---
<div class="prose"><slot /></div>

<style lang="scss">
  @use 'tokens' as *;

  .prose {
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: color(gray, 700);

    > :global(* + *) { margin-top: 1.25rem; }
    :global(h1), :global(h2), :global(h3), :global(h4) {
      color: color(gray, 900);
      font-weight: 700;
      line-height: 1.3;
    }
    :global(h1) { font-size: 2.25rem; margin-top: 0; }
    :global(h2) { font-size: 1.5rem; margin-top: 2rem; }
    :global(h3) { font-size: 1.25rem; margin-top: 1.6rem; }
    :global(h4) { font-size: 1.125rem; margin-top: 1.5rem; }
    :global(a) {
      color: color(blue, 600);
      text-decoration: underline;
      font-weight: 500;
    }
    :global(strong) { color: color(gray, 900); font-weight: 600; }
    :global(ul), :global(ol) { padding-left: 1.625rem; }
    :global(ul) { list-style: disc; }
    :global(ol) { list-style: decimal; }
    :global(li) { margin-top: 0.5rem; }
    :global(blockquote) {
      border-left: 4px solid color(gray, 200);
      padding-left: 1rem;
      font-style: italic;
      color: color(gray, 900);
    }
    :global(code) {
      font-family: var(--font-mono);
      font-size: 0.875em;
      background: color(gray, 100);
      padding: 0.125rem 0.375rem;
      border-radius: var(--radius-sm);
    }
    :global(pre) {
      background: color(gray, 800);
      color: color(gray, 200);
      padding: 1rem;
      border-radius: var(--radius-lg);
      overflow-x: auto;
      font-size: 0.875rem;
    }
    :global(pre code) { background: none; padding: 0; color: inherit; }
    :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-lg); }
    :global(hr) { border: 0; border-top: 1px solid color(gray, 200); margin-block: 3rem; }
  }
</style>
