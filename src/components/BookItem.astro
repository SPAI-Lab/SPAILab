---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'> | CollectionEntry<'books'>;
}

const { entry } = Astro.props;
const { title, authors, year, venue, links, cover, badges } = entry.data;
---

<div class="book">
  <div class="book__cover">
    {cover ? (
      <Image src={cover} alt={title} />
    ) : (
      <div class="book__nocover">
        <span>No Cover</span>
      </div>
    )}

    {/* Badges Overlay */}
    {badges && badges.length > 0 && (
      <div class="book__badges">
        {badges.map(badge => (
          <span class:list={['badge', { 'badge--gold': badge.type === 'gold', 'badge--blue': badge.type === 'blue' }]}>
            {badge.text}
          </span>
        ))}
      </div>
    )}
  </div>

  <div class="book__body">
    <div class="book__text">
      <h3>{title}</h3>
      <p>{authors.join(', ')}</p>
    </div>

    <div class="book__footer">
      <div class="book__venue">
        <span class="book__venue-name">{venue}</span>
        <span>•</span>
        <time>{year}</time>
      </div>

      {links && (links.website || links.pdf) && (
        <div class="book__links">
          {links.website && (
            <a href={links.website} target="_blank" rel="noopener noreferrer">Website</a>
          )}
          {links.pdf && (
            <a href={links.pdf} target="_blank" rel="noopener noreferrer">PDF</a>
          )}
        </div>
      )}
    </div>
  </div>
</div>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .book {
    @include surface;
    display: flex; flex-direction: column; height: 100%; overflow: hidden;
    transition: box-shadow 0.3s;
    &:hover { box-shadow: var(--shadow-lg); }
  }
  .book__cover {
    position: relative; aspect-ratio: 3 / 4; overflow: hidden; background: color(gray, 100);
    :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  }
  .book:hover .book__cover :global(img) { transform: scale(1.05); }
  .book__nocover {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    color: color(gray, 400); background: color(gray, 50);
    span { font-size: 0.875rem; line-height: 1.25rem; }
  }

  .book__badges { position: absolute; top: 0.5rem; right: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-end; }
  .badge {
    padding: 0.25rem 0.5rem; font-size: 0.75rem; line-height: 1rem; font-weight: 700;
    border-radius: var(--radius-sm); box-shadow: var(--shadow-sm); backdrop-filter: blur(12px);
    background: rgb(243 244 246 / 0.9); color: color(gray, 700); border: 1px solid color(gray, 200);
  }
  .badge--gold { background: rgb(254 249 195 / 0.9); color: color(yellow, 700); border-color: color(yellow, 200); }
  .badge--blue { background: rgb(219 234 254 / 0.9); color: color(blue, 700); border-color: color(blue, 200); }

  .book__body { padding: 1.25rem; display: flex; flex-direction: column; flex-grow: 1; }
  .book__text { margin-bottom: 1rem; }
  h3 {
    font-size: 1.125rem; line-height: 1.25; font-weight: 700; color: color(gray, 900);
    margin-bottom: 0.5rem; transition: color 0.15s;
  }
  .book:hover h3 { color: color(blue, 600); }
  p { font-size: 0.875rem; line-height: 1.625; color: color(gray, 600); }

  .book__footer {
    margin-top: auto; padding-top: 1rem; border-top: 1px solid color(gray, 50);
    display: flex; align-items: center; justify-content: space-between;
    font-size: 0.875rem; line-height: 1.25rem;
  }
  .book__venue { display: flex; align-items: center; gap: 0.5rem; color: color(gray, 500); }
  .book__venue-name { font-weight: 500; color: color(gray, 900); }
  .book__links { display: flex; gap: 0.5rem; }
  .book__links a { color: color(blue, 600); font-weight: 500; &:hover { color: color(blue, 800); } }
</style>
