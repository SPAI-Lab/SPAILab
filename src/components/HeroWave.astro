---
// Full-bleed equalizer-style waveform that echoes the lab logo. Bars react to the pointer.
---

<div class="hero-wave" data-hero-wave aria-hidden="true">
  <canvas data-canvas></canvas>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-wave]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const hero = root.parentElement ?? root;
    let w = 0;
    let h = 0;
    let t = 1.2; // animation phase; also the frozen pose while the wave is asleep
    let raf = 0;
    let last = 0;
    let visible = true;
    // Pointer position in 0..1 (eased), rests on the right where the empty space is.
    let targetX = 0.78;
    let pointerX = 0.78;
    let energy = 0; // eased 0..1 boost while the pointer moves

    // The wave starts frozen. It wakes up after the pointer has been moving over the hero for
    // WAKE_AFTER seconds in total, and falls asleep again once the pointer has been idle for IDLE_SLEEP.
    const WAKE_AFTER = 3; // seconds of hovering/moving
    const MOVE_GAP = 400; // ms: a pause shorter than this still counts as "moving"
    const IDLE_SLEEP = 3000; // ms without movement before it goes back to sleep
    let awake = 0; // eased 0..1
    let hoverTime = 0;
    let lastMove = -Infinity;
    let inside = false;

    const cssVar = (n: string) => getComputedStyle(root!).getPropertyValue(n).trim();

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const r = root!.getBoundingClientRect();
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      const color = cssVar('--wave-color');
      const baseY = h * 0.8;
      const gap = w < 640 ? 9 : 14;
      const barW = w < 640 ? 4 : 6;
      const count = Math.floor(w / gap);
      const maxH = h * 0.3;

      // Baseline, like the logo.
      ctx.fillStyle = cssVar('--wave-line');
      ctx.fillRect(0, baseY, w, 1);

      ctx.fillStyle = color;
      for (let i = 0; i < count; i++) {
        const x = i / (count - 1);
        // Quiet under the headline (left), loud on the right, plus a bump that follows the pointer.
        const rest = 0.08 + 0.92 * Math.exp(-(((x - 0.78) / 0.24) ** 2));
        // While asleep the pointer only nudges the bars a little (hover feedback); awake it is full strength.
        const bump = Math.exp(-(((x - pointerX) / 0.12) ** 2)) * (0.35 + 0.65 * energy) * (0.3 + 0.7 * awake);
        const env = Math.min(1, rest * 0.75 + bump);
        // Layered sines give an organic, speech-like flutter.
        const flutter =
          0.5 +
          0.3 * Math.sin(t * 1.4 + i * 0.55) +
          0.2 * Math.sin(t * 2.3 + i * 1.3);
        const bh = Math.max(2, env * flutter * maxH);
        const px = i * gap + (w - (count - 1) * gap) / 2 - barW / 2;
        const radius = barW / 2;
        ctx.globalAlpha = 0.35 + 0.65 * env;
        ctx.beginPath();
        ctx.roundRect(px, baseY - bh, barW, bh * 2, radius);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function frame(now: number) {
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0);
      last = now;

      const moving = inside && now - lastMove < MOVE_GAP;
      if (moving) hoverTime += dt;
      if (now - lastMove > IDLE_SLEEP) hoverTime = 0; // idle long enough: needs a fresh 3s next time

      const target = hoverTime >= WAKE_AFTER ? 1 : 0;
      awake += (target - awake) * Math.min(1, dt * 2.5);
      if (Math.abs(target - awake) < 0.002) awake = target;

      t += dt * awake;
      pointerX += (targetX - pointerX) * Math.min(1, dt * 5);
      energy *= Math.pow(0.96, dt * 60);

      draw();

      // Only keep the loop alive while something is changing; a sleeping, untouched wave costs nothing.
      const busy = awake > 0 || target > 0 || energy > 0.01 || moving || hoverTime > 0 || Math.abs(pointerX - targetX) > 0.002;
      raf = visible && busy && !reduceMotion ? requestAnimationFrame(frame) : 0;
      if (!raf) last = 0;
    }
    const kick = () => {
      if (!raf && !reduceMotion) raf = requestAnimationFrame(frame);
    };

    hero.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      targetX = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      energy = 1;
      inside = true;
      lastMove = performance.now();
      kick();
    });
    hero.addEventListener('pointerleave', () => {
      inside = false;
      targetX = 0.78;
      kick();
    });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) kick();
    }).observe(root);

    new ResizeObserver(() => {
      resize();
      draw();
    }).observe(root);

    resize();
    draw();
    kick();
  }
</script>

<style lang="scss">
  @use 'tokens' as *;

  .hero-wave {
    position: absolute;
    inset: 0;
    --wave-color: var(--c-red-600);
    --wave-line: rgb(255 255 255 / 0.14);
    background:
      radial-gradient(60rem 30rem at 78% 80%, rgb(220 38 38 / 0.16), transparent 70%),
      linear-gradient(to bottom, #0a0a0d, #121218);

    canvas { display: block; width: 100%; height: 100%; }
  }
</style>
