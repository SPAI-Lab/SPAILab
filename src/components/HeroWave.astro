---
// Full-bleed equalizer-style waveform that echoes the lab logo. Bars react to the pointer.
---

<div class="hero-wave" data-hero-wave aria-hidden="true">
  <canvas data-canvas></canvas>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-wave]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const hero = root.parentElement ?? root;
    let w = 0;
    let h = 0;
    let t = 0;
    let raf = 0;
    let visible = true;
    // Pointer position in 0..1 (eased), rests on the right where the empty space is.
    let targetX = 0.78;
    let pointerX = 0.78;
    let energy = 0; // eased 0..1 boost while the pointer moves

    const cssVar = (n: string) => getComputedStyle(root!).getPropertyValue(n).trim();

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const r = root!.getBoundingClientRect();
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      const color = cssVar('--wave-color');
      const baseY = h * 0.8;
      const gap = w < 640 ? 9 : 14;
      const barW = w < 640 ? 4 : 6;
      const count = Math.floor(w / gap);
      const maxH = h * 0.3;

      // Baseline, like the logo.
      ctx.fillStyle = cssVar('--wave-line');
      ctx.fillRect(0, baseY, w, 1);

      ctx.fillStyle = color;
      for (let i = 0; i < count; i++) {
        const x = i / (count - 1);
        // Quiet under the headline (left), loud on the right, plus a bump that follows the pointer.
        const rest = 0.08 + 0.92 * Math.exp(-(((x - 0.78) / 0.24) ** 2));
        const bump = Math.exp(-(((x - pointerX) / 0.12) ** 2)) * (0.35 + 0.65 * energy);
        const env = Math.min(1, rest * 0.75 + bump);
        // Layered sines give an organic, speech-like flutter.
        const flutter =
          0.5 +
          0.3 * Math.sin(t * 1.4 + i * 0.55) +
          0.2 * Math.sin(t * 2.3 + i * 1.3);
        const bh = Math.max(2, env * flutter * maxH);
        const px = i * gap + (w - (count - 1) * gap) / 2 - barW / 2;
        const radius = barW / 2;
        ctx.globalAlpha = 0.35 + 0.65 * env;
        ctx.beginPath();
        ctx.roundRect(px, baseY - bh, barW, bh * 2, radius);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function frame() {
      if (!reduceMotion) {
        t += 0.016;
        pointerX += (targetX - pointerX) * 0.08;
        energy *= 0.96;
      }
      draw();
      raf = visible && !reduceMotion ? requestAnimationFrame(frame) : 0;
    }
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    hero.addEventListener('pointermove', (e) => {
      const r = root.getBoundingClientRect();
      targetX = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      energy = 1;
    });
    hero.addEventListener('pointerleave', () => {
      targetX = 0.78;
    });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) kick();
    }).observe(root);

    new ResizeObserver(() => {
      resize();
      draw();
    }).observe(root);

    resize();
    draw();
    kick();
  }
</script>

<style lang="scss">
  @use 'tokens' as *;

  .hero-wave {
    position: absolute;
    inset: 0;
    --wave-color: var(--c-red-600);
    --wave-line: rgb(255 255 255 / 0.14);
    background:
      radial-gradient(60rem 30rem at 78% 80%, rgb(220 38 38 / 0.16), transparent 70%),
      linear-gradient(to bottom, #0a0a0d, #121218);

    canvas { display: block; width: 100%; height: 100%; }
  }
</style>
