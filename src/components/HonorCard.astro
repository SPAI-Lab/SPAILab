---
import { Medal, Trophy, Award, Crown, Star } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';

interface Props {
  honor: CollectionEntry<'honors'>;
}

const { honor } = Astro.props;
const { level, type, year, title, award } = honor.data;

const getTrophyConfig = (level: string) => {
  switch (level) {
    case 'Special':
      return { icon: Crown, tone: 'special' };
    case 'First':
      return { icon: Trophy, tone: 'first' };
    case 'Second':
      return { icon: Medal, tone: 'second' };
    case 'Third':
      return { icon: Award, tone: 'third' };
    default:
      return { icon: Star, tone: 'default' };
  }
};

const config = getTrophyConfig(level);
const Icon = config.icon;
---

<div class:list={['honor', `honor--${config.tone}`]}>
  <div class="honor__medal">
    <Icon size={32} />
  </div>
  <div class="honor__body">
    <div class="honor__tags">
      <span class="honor__year">{year}</span>
      <span class="honor__type">{type}</span>
    </div>
    <h3>{title}</h3>
    <p class="honor__award">
      <Icon size={16} />
      {award}
    </p>
  </div>
</div>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  // Per-level palette via custom properties: icon color, gradient from/to, ring.
  @mixin tone($fg, $from, $to, $ring) {
    --honor-color: #{$fg};
    --honor-from: #{$from};
    --honor-to: #{$to};
    --honor-ring: #{$ring};
  }

  .honor {
    @include surface;
    display: flex; align-items: flex-start; gap: 1rem; padding: 1.5rem;
    box-shadow: var(--shadow-sm); transition: box-shadow 0.2s ease;
    &:hover { box-shadow: var(--shadow-md); }
  }
  .honor--special { @include tone(color(purple, 600), color(purple, 100), color(pink, 100), color(purple, 200)); }
  .honor--first   { @include tone(color(yellow, 500), color(yellow, 100), color(amber, 100), color(amber, 200)); }
  .honor--second  { @include tone(color(gray, 500), color(gray, 100), color(slate, 200), color(gray, 300)); }
  .honor--third   { @include tone(color(amber, 700), color(orange, 100), color(amber, 100), color(orange, 200)); }
  .honor--default { @include tone(color(blue, 500), color(blue, 50), color(indigo, 50), color(blue, 100)); }

  .honor__medal {
    position: relative; flex-shrink: 0; width: 4rem; height: 4rem; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-full); border: 4px solid var(--c-white);
    background: linear-gradient(to bottom right, var(--honor-from), var(--honor-to));
    color: var(--honor-color);
    box-shadow: var(--shadow-sm), 0 0 0 1px var(--honor-ring);
  }
  .honor__body { flex: 1; }
  .honor__tags { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  .honor__year {
    padding: 0.125rem 0.625rem; font-size: 0.75rem; line-height: 1rem; font-weight: 700;
    background: color(blue, 50); color: color(blue, 600); border-radius: var(--radius-full); border: 1px solid color(blue, 100);
  }
  .honor__type {
    padding: 0.125rem 0.625rem; font-size: 0.75rem; line-height: 1rem; font-weight: 500;
    background: color(gray, 100); color: color(gray, 600); border-radius: var(--radius-full);
  }
  h3 {
    font-size: 1.125rem; line-height: 1.25; font-weight: 700; color: color(gray, 900);
    margin-bottom: 0.25rem; transition: color 0.15s;
  }
  .honor:hover h3 { color: color(blue, 600); }
  .honor__award {
    display: flex; align-items: center; gap: 0.25rem;
    font-weight: 700; font-size: 0.875rem; line-height: 1.25rem; color: var(--honor-color);
  }
</style>
