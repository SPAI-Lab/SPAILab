---
import { url } from '../lib/url';
import { SITE, LOGO_IMAGE } from '../config';
import { 
  Menu, X, Globe, ChevronDown, Check, Moon, Sun,
  Home, BookOpen, Trophy, Users, Calendar, UserPlus, Sparkles, Search
} from 'lucide-react';

import { ui, defaultLang, languages } from '../i18n/ui';

const { nav, i18n, customPages } = SITE;

const iconMap: Record<string, any> = {
  home: Home,
  research: BookOpen,
  achievements: Trophy,
  team: Users,
  activities: Calendar,
  join: UserPlus,
  search: Search,
};

// Helper to get icon
const getIcon = (key: string) => iconMap[key] || Sparkles;
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__bar">
      <!-- Logo & Name -->
      <div class="brand">
        <a href={url("/")} class="brand__link">
          {LOGO_IMAGE.enable && SITE.logo && <img src={url(SITE.logo)} alt="Logo" class="brand__logo" />}
          <div class="brand__text">
            <span class="brand__name">
              {SITE.labName}
            </span>
            <span class="brand__university">
              {SITE.university}
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="desktop-nav">
        {nav.map(item => {
          if (item.key === 'search') {
            return (
              <a 
                href={url(item.link)} 
                class="desktop-nav__icon-link"
                aria-label={item.text}
              >
                <Search size={20} />
              </a>
            );
          }
          return (
            <a 
              href={url(item.link)} 
              class="desktop-nav__link"
              data-i18n-key={`nav.${item.key}`}
            >
              {item.text}
            </a>
          );
        })}
        
        <!-- Custom Pages -->
        {customPages && customPages.map(item => (
           <a 
             href={url(item.link)} 
             class="desktop-nav__link"
             data-i18n-key={item.key} 
           >
             {item.text}
           </a>
        ))}
        
        {i18n.enabled && (
          <div class="lang-switcher">
            <button 
              class="lang-switcher__button"
              aria-label="Select Language"
            >
              <Globe size={16} />
              <span class="lang-switcher__label" id="current-lang-label">ZH</span>
              <ChevronDown size={12} className="lang-switcher__caret" />
            </button>
            
            <!-- Dropdown Menu -->
            <div class="lang-switcher__dropdown">
              <div class="lang-switcher__panel">
                {Object.entries(languages).map(([code, label]) => (
                  <button
                    class="lang-switcher__option lang-option"
                    data-lang={code}
                  >
                    <span>{label}</span>
                    <Check size={16} className="lang-switcher__check" />
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}
      </nav>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        class="menu-btn" 
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        onclick="window.toggleMobileMenu(event)"
      >
        <span class="icon-menu menu-btn__open">
          <Menu size={24} />
        </span>
        <span class="icon-close menu-btn__close is-hidden is-rotated">
          <X size={24} />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Nav Overlay (Solid White) -->
  <div 
    id="mobile-menu" 
    class="mobile-menu"
    style="display: none;"
    role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="mobile-menu-title"
  >
    <!-- Header with Close Button -->
    <div class="mobile-menu__top">
      <div class="mobile-menu__brand">
        {LOGO_IMAGE.enable && SITE.logo && <img src={url(SITE.logo)} alt="Logo" class="mobile-menu__logo" />}
        <span class="mobile-menu__name">{SITE.labName}</span>
      </div>
      <button 
        onclick="window.closeMobileMenu()" 
        class="mobile-menu__close"
        aria-label="Close menu"
      >
        <X size={32} />
      </button>
    </div>
    
    <!-- Scrollable Menu Content -->
    <nav class="mobile-menu__nav">
      {nav.map((item) => (
        <a 
          href={url(item.link)} 
          class="mobile-menu__link"
          data-i18n-key={`nav.${item.key}`}
          onclick="window.closeMobileMenu()"
        >
          <span>{item.text}</span>
          <ChevronDown size={20} className="mobile-menu__chevron" />
        </a>
      ))}
      
      <!-- Custom Pages Mobile -->
      {customPages && customPages.map((item) => (
        <a 
          href={url(item.link)} 
          class="mobile-menu__link"
          data-i18n-key={item.key}
          onclick="window.closeMobileMenu()"
        >
           <span>{item.text}</span>
           <ChevronDown size={20} className="mobile-menu__chevron" />
        </a>
      ))}

      {i18n.enabled && (
        <div class="mobile-menu__lang">
          <div class="mobile-menu__lang-title">Language</div>
          <div class="mobile-menu__lang-grid">
            {Object.entries(languages).map(([code, label]) => (
              <button
                class="mobile-menu__lang-option lang-option mobile-lang-option"
                data-lang={code}
                onclick="window.setLanguage && window.setLanguage(this.getAttribute('data-lang')); window.closeMobileMenu()"
              >
                {label}
              </button>
            ))}
          </div>
        </div>
      )}
    </nav>

    <!-- Footer Info -->
    <div class="mobile-menu__footer">
       <p>© {new Date().getFullYear()} {SITE.labName}</p>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.querySelector('.icon-menu');
    const iconClose = document.querySelector('.icon-close');
    const langLabel = document.getElementById('current-lang-label');

    let lastFocusedEl = null;

    function setAria(open) {
      btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu?.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    function trapFocus(e) {
      if (!menu || !menu.contains(document.activeElement)) return;
      if (e.key !== 'Tab') return;
      const focusable = menu.querySelectorAll('a, button, input, [tabindex]:not([tabindex="-1"])');
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function onKeydown(e) {
      if (e.key === 'Escape') {
        window.closeMobileMenu();
      } else {
        trapFocus(e);
      }
    }

    function openMenu() {
      // Show menu container (display: flex)
      if (menu) {
        menu.style.display = 'flex';
        // Force reflow
        menu.offsetHeight;
        
        // Add simple fade in
        menu.animate([
          { opacity: 0 },
          { opacity: 1 }
        ], {
          duration: 200,
          fill: 'forwards',
          easing: 'ease-out'
        });
      }
      
      // Animate hamburger to X
      iconMenu?.classList.add('is-open');
      iconClose?.classList.remove('is-hidden', 'is-rotated');
      
      // Lock body scroll
      document.body.classList.add('menu-open');
      setAria(true);

      lastFocusedEl = document.activeElement;
      // Focus the first link
      const firstLink = menu?.querySelector('a');
      firstLink?.focus?.();
      
      document.addEventListener('keydown', onKeydown);
    }

    window.closeMobileMenu = function() {
      // Animate fade out
      if (menu) {
        const animation = menu.animate([
          { opacity: 1 },
          { opacity: 0 }
        ], {
          duration: 200,
          fill: 'forwards',
          easing: 'ease-in'
        });
        
        animation.onfinish = () => {
          menu.style.display = 'none';
        };
      }
      
      // Animate X back to hamburger
      iconMenu?.classList.remove('is-open');
      iconClose?.classList.add('is-rotated');
      setTimeout(() => {
        iconClose?.classList.add('is-hidden');
      }, 200);

      // Unlock body scroll
      document.body.classList.remove('menu-open');
      setAria(false);

      document.removeEventListener('keydown', onKeydown);
      if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
        lastFocusedEl.focus();
      } else {
        btn?.focus?.();
      }
    };

    window.toggleMobileMenu = function(e) {
      if (e) e.stopPropagation();
      if (!menu) return;
      const isHidden = menu.style.display === 'none';
      if (isHidden) openMenu();
      else window.closeMobileMenu();
    };

    // Close on link click in drawer
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', window.closeMobileMenu);
    });

    // Language handling
    function updateHeaderLang(lang) {
      if (langLabel) langLabel.textContent = lang.toUpperCase();
      document.querySelectorAll('.lang-option').forEach(btn => {
        const btnLang = btn.getAttribute('data-lang');
        if (btnLang === lang) {
          btn.classList.add('is-active');
        } else {
          btn.classList.remove('is-active');
        }
      });
    }

    window.addEventListener('language-change', (e) => {
      updateHeaderLang(e.detail.lang);
    });

    try {
      const saved = localStorage.getItem('preferred-lang') || defaultLang;
      updateHeaderLang(saved);
    } catch {}

    document.querySelectorAll('.lang-option:not(.mobile-lang-option)').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (window.setLanguage) window.setLanguage(lang);
      });
    });

    // Auto close when resizing to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) window.closeMobileMenu();
    });
  })();
</script>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: rgb(255 255 255 / 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color(gray, 100);
    transition: color 0.3s, background-color 0.3s, border-color 0.3s;
  }

  .site-header__inner {
    @include container(default);
  }

  .site-header__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }

  // Brand
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .brand__logo {
    height: 2rem;
    width: 2rem;
    object-fit: contain;
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    @include up(sm) {
      flex-direction: row;
      align-items: flex-end;
      gap: 0.5rem;
    }
  }
  .brand__name {
    font-weight: 700;
    color: color(gray, 900);
    font-size: 1.125rem;
    line-height: 1.25;
    transition: color 0.15s;
  }
  .brand__link:hover .brand__name { color: color(blue, 600); }
  .brand__university {
    display: none;
    color: color(gray, 500);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 300;
    padding-bottom: 0.125rem;
    @include up(sm) { display: inline; }
  }

  // Desktop nav
  .desktop-nav {
    display: none;
    gap: 1.5rem;
    align-items: center;
    @include up(md) { display: flex; }
  }
  .desktop-nav__link {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: color(gray, 600);
    transition: color 0.15s;
    &:hover { color: color(blue, 600); }
  }
  .desktop-nav__icon-link {
    padding: 0.5rem;
    color: color(gray, 600);
    border-radius: var(--radius-full);
    transition: color 0.15s, background-color 0.15s;
    &:hover {
      color: color(blue, 600);
      background: color(gray, 50);
    }
  }

  // Language switcher (desktop)
  .lang-switcher {
    position: relative;
    margin-left: 0.5rem;
    &:hover .lang-switcher__dropdown { display: block; }
  }
  .lang-switcher__button {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-full);
    background: color(gray, 50);
    color: color(gray, 600);
    transition: background-color 0.15s, color 0.15s;
    outline: none;
    &:hover { background: color(gray, 100); }
  }
  .lang-switcher__label {
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    text-transform: uppercase;
  }
  .lang-switcher__button :global(.lang-switcher__caret) { opacity: 0.5; }
  .lang-switcher__dropdown {
    position: absolute;
    right: 0;
    padding-top: 0.5rem;
    width: 10rem;
    display: none;
    transform-origin: top right;
  }
  .lang-switcher__panel {
    background: var(--c-white);
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    border: 1px solid color(gray, 100);
    padding-block: 0.5rem;
  }
  .lang-switcher__option {
    width: 100%;
    text-align: left;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: color(gray, 600);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.15s, background-color 0.15s;
    &:hover,
    &.is-active {
      background: color(blue, 50);
      color: color(blue, 600);
    }
  }
  .lang-switcher__option :global(.lang-switcher__check) {
    color: color(blue, 600);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .lang-switcher__option.is-active :global(.lang-switcher__check) { opacity: 1; }

  // Mobile menu button
  .menu-btn {
    position: relative;
    z-index: 80;
    padding: 0.5rem;
    margin-right: -0.5rem;
    color: color(gray, 600);
    border-radius: var(--radius-lg);
    transition: background-color 0.15s, color 0.15s;
    &:hover { background: color(gray, 100); }
    @include up(md) { display: none; }
  }
  .menu-btn__open {
    display: block;
    transition: transform 0.3s;
    &.is-open {
      transform: rotate(90deg);
      opacity: 0;
    }
  }
  .menu-btn__close {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
    &.is-rotated { transform: rotate(90deg); }
    &.is-hidden { display: none; }
  }

  // Mobile overlay (display is toggled inline by the script)
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100vw;
    height: 100vh;
    background: var(--c-white);
    flex-direction: column;
    @include up(md) { display: none; }
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.5rem;
    height: 5rem;
    border-bottom: 1px solid color(gray, 100);
    flex-shrink: 0;
    background: var(--c-white);
  }
  .mobile-menu__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mobile-menu__logo {
    height: 2.5rem;
    width: 2.5rem;
    object-fit: contain;
  }
  .mobile-menu__name {
    font-weight: 700;
    color: color(gray, 900);
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
  .mobile-menu__close {
    padding: 0.5rem;
    margin-right: -0.5rem;
    border-radius: var(--radius-full);
    color: color(gray, 600);
    transition: background-color 0.15s;
    &:hover { background: color(gray, 100); }
  }
  .mobile-menu__nav {
    flex: 1 1 0%;
    overflow-y: auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--c-white);
  }
  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: color(gray, 800);
    border-radius: var(--radius-xl);
    border-bottom: 1px solid color(gray, 100);
    transition: all 0.15s;
    &:hover {
      color: color(blue, 600);
      background: color(gray, 50);
    }
    &:last-child { border-bottom: 0; }
  }
  .mobile-menu__link :global(.mobile-menu__chevron) {
    transform: rotate(-90deg);
    color: color(gray, 400);
  }
  .mobile-menu__lang {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color(gray, 100);
  }
  .mobile-menu__lang-title {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 700;
    color: color(gray, 500);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-inline: 0.5rem;
  }
  .mobile-menu__lang-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .mobile-menu__lang-option {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-xl);
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
    border: 1px solid color(gray, 200);
    color: color(gray, 600);
    text-align: center;
    transition: all 0.15s;
    &:hover {
      border-color: color(blue, 600);
      color: color(blue, 600);
      background: color(blue, 50);
    }
    &.is-active {
      color: color(blue, 600);
      background: color(blue, 50);
      border-color: color(blue, 200);
    }
  }
  .mobile-menu__footer {
    padding: 2rem;
    background: color(gray, 50);
    flex-shrink: 0;
    border-top: 1px solid color(gray, 200);
    p {
      font-size: 0.875rem;
      line-height: 1.25rem;
      color: color(gray, 500);
      font-weight: 500;
      text-align: center;
    }
  }

  // Body scroll lock while the mobile menu is open
  :global(body.menu-open) { overflow: hidden; }
</style>
