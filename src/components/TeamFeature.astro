---
// Wide profile card for faculty / PI. Students use the compact TeamCard.
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Mail, Phone, MapPin, FlaskConical, ArrowRight } from 'lucide-react';
import Badge from './ui/Badge.astro';
import placeholder from '../assets/avatar-placeholder.svg';

interface Props { member: CollectionEntry<'team'>; }

const { member } = Astro.props;
const { name, avatar, avatarUrl, bio, email, phone, office, lab, title } = member.data;
const profileUrl = url(`/team/${member.id.replace(/\.[^/.]+$/, '')}`);

const rows = [
  office && { Icon: MapPin, text: office },
  lab && { Icon: FlaskConical, text: lab },
  phone && { Icon: Phone, text: phone, href: `tel:${phone}` },
  email && { Icon: Mail, text: email, href: `mailto:${email}` },
].filter(Boolean) as Array<{ Icon: any; text: string; href?: string }>;
---
<article class="feature">
  <a href={profileUrl} class="feature__photo" tabindex="-1" aria-hidden="true">
    <img src={avatarUrl ?? (avatar ?? placeholder).src} alt="" loading="lazy" />
  </a>

  <div class="feature__body">
    <h3 class="feature__name"><a href={profileUrl}>{name}</a></h3>

    {title && title.length > 0 && (
      <div class="feature__badges">
        {title.map((t, i) => <Badge hue={i === 0 ? 'red' : 'gray'}>{t}</Badge>)}
      </div>
    )}

    {bio && <p class="feature__bio">{bio}</p>}

    {rows.length > 0 && (
      <ul class="feature__contact">
        {rows.map(({ Icon, text, href }) => (
          <li>
            <Icon size={16} />
            {href ? <a href={href}>{text}</a> : <span>{text}</span>}
          </li>
        ))}
      </ul>
    )}

    <a href={profileUrl} class="feature__more">
      <span data-i18n-key="team.profile">View profile</span>
      <ArrowRight size={16} />
    </a>
  </div>
</article>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .feature {
    @include surface(var(--radius-2xl));
    display: grid; gap: 1.5rem; padding: 1.5rem;
    transition: box-shadow 0.15s ease;
    &:hover { box-shadow: var(--shadow-md); }

    @include up(sm) { grid-template-columns: 11rem 1fr; gap: 2rem; padding: 2rem; }
  }

  .feature__photo {
    display: block; width: 9rem; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-xl); background: color(gray, 100);
    @include up(sm) { width: 100%; }
    img { width: 100%; height: 100%; object-fit: cover; }
  }

  .feature__name {
    font-size: 1.5rem; line-height: 2rem; font-weight: 700; color: color(gray, 900);
    a:hover { color: color(red, 600); }
  }
  .feature__badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .feature__bio { margin-top: 1rem; color: color(gray, 600); line-height: 1.75; word-break: keep-all; }

  .feature__contact {
    list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.375rem;
    font-size: 0.9375rem; color: color(gray, 700);
    li { display: flex; align-items: center; gap: 0.625rem; }
    svg { flex-shrink: 0; color: color(red, 600); }
    a:hover { color: color(red, 600); text-decoration: underline; }
  }

  .feature__more {
    display: inline-flex; align-items: center; gap: 0.375rem; margin-top: 1.5rem;
    font-size: 0.9375rem; font-weight: 600; color: color(gray, 900);
    transition: color 0.15s ease, gap 0.15s ease;
    &:hover { color: color(red, 600); gap: 0.625rem; }
  }
</style>
