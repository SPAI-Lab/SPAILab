---
import Container from './ui/Container.astro';
---

<section class="denoise" data-denoise>
  <Container>
    <header class="denoise__head">
      <h2 data-i18n-key="demo.title">From noisy signal to clean insight</h2>
      <p data-i18n-key="demo.subtitle">Drag the slider — or just scroll — to watch an AI denoiser recover an active-sonar echo buried in noise.</p>
    </header>

    <div class="denoise__panel">
      <div class="denoise__legend">
        <span class="denoise__key denoise__key--noise" data-i18n-key="demo.noisy">Noisy input</span>
        <span class="denoise__key denoise__key--clean" data-i18n-key="demo.denoised">Denoised output</span>
        <span class="denoise__snr">SNR <strong data-snr>-6 dB</strong></span>
      </div>

      <canvas class="denoise__canvas" data-canvas role="img" aria-label="Waveform: noisy sonar signal becoming clean as denoising increases"></canvas>

      <label class="denoise__control">
        <span data-i18n-key="demo.slider">AI denoising</span>
        <input type="range" min="0" max="100" value="0" data-slider />
        <output data-percent>0%</output>
      </label>
    </div>
  </Container>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-denoise]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-slider]')!;
    const percent = root.querySelector<HTMLElement>('[data-percent]')!;
    const snrEl = root.querySelector<HTMLElement>('[data-snr]')!;
    const ctx = canvas.getContext('2d')!;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const N = 600;
    // Seeded RNG so the noise is identical on every frame (no flicker) and every visit.
    let seed = 7;
    const rand = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
    const noise = Float32Array.from({ length: N }, () => (rand() + rand() + rand() - 1.5) * 1.6);

    // Active-sonar style trace: transmit ping + two weaker echoes, each a windowed sine burst.
    const bursts = [
      { at: 0.18, w: 0.05, a: 0.9 },
      { at: 0.55, w: 0.06, a: 0.6 },
      { at: 0.82, w: 0.05, a: 0.35 },
    ];
    const clean = (x: number, t: number) =>
      bursts.reduce((s, b) => s + b.a * Math.exp(-(((x - b.at) / b.w) ** 2)) * Math.sin(2 * Math.PI * (60 * x - t)), 0);

    const SIGMA2 = noise.reduce((s, v) => s + v * v, 0) / N;
    const SIGNAL_P = (() => {
      let s = 0;
      for (let i = 0; i < N; i++) s += clean(i / (N - 1), 0) ** 2;
      return s / N;
    })();

    let denoise = 0; // 0..1
    let userDriven = false;
    let visible = false;
    let raf = 0;
    let time = 0;

    const cssVar = (name: string) => getComputedStyle(canvas).getPropertyValue(name).trim();

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function trace(w: number, mid: number, amp: number, color: string, alpha: number, lw: number, f: (i: number, x: number) => number) {
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = color;
      ctx.lineWidth = lw;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      for (let i = 0; i < N; i++) {
        const x = i / (N - 1);
        const px = x * w;
        const py = mid - f(i, x) * amp;
        if (i) ctx.lineTo(px, py);
        else ctx.moveTo(px, py);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;
    }

    function draw() {
      const { width: w, height: h } = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, w, h);
      const mid = h / 2;
      const amp = h * 0.36;

      ctx.strokeStyle = cssVar('--demo-grid');
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, mid);
      ctx.lineTo(w, mid);
      ctx.stroke();

      const resid = 1 - denoise;
      // Raw noisy input stays as a faint reference; the red trace is the model output.
      trace(w, mid, amp, cssVar('--demo-noise'), 0.55, 1, (i, x) => clean(x, time) + noise[i]);
      trace(w, mid, amp, cssVar('--demo-signal'), 1, 2, (i, x) => clean(x, time) + noise[i] * resid * resid);
    }

    function updateReadout() {
      const resid = 1 - denoise;
      const noiseP = SIGMA2 * resid ** 4 + 1e-4;
      const snr = Math.min(10 * Math.log10(SIGNAL_P / noiseP), 35);
      snrEl.textContent = `${snr.toFixed(0)} dB`;
      percent.textContent = `${Math.round(denoise * 100)}%`;
      slider.value = String(Math.round(denoise * 100));
    }

    function frame() {
      if (!reduceMotion) time += 0.012;
      draw();
      raf = visible && !reduceMotion ? requestAnimationFrame(frame) : 0;
    }
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    // Scroll drives the slider until the visitor touches it.
    function onScroll() {
      if (userDriven) return;
      const r = root!.getBoundingClientRect();
      const vh = innerHeight;
      // 0 as the panel enters from below, 1 once it is ~1/3 up the viewport.
      const p = (vh - r.top) / (vh * 0.65 + r.height * 0.3);
      denoise = Math.min(1, Math.max(0, p));
      updateReadout();
      if (reduceMotion) draw();
    }

    slider.addEventListener('input', () => {
      userDriven = true;
      denoise = Number(slider.value) / 100;
      updateReadout();
      if (reduceMotion) draw();
      else kick();
    });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) kick();
    }).observe(root);

    addEventListener('scroll', onScroll, { passive: true });
    new ResizeObserver(() => {
      resize();
      draw();
    }).observe(canvas);
    resize();
    onScroll();
    updateReadout();
    draw();
  }
</script>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .denoise {
    padding-block: 4rem;
    background: var(--c-white);
    --demo-signal: var(--c-red-600);
    --demo-noise: var(--c-gray-400);
    --demo-grid: var(--c-gray-200);
  }

  .denoise__head {
    max-width: 42rem;
    margin-bottom: 2rem;

    h2 { font-size: 1.875rem; line-height: 2.25rem; font-weight: 700; color: color(gray, 900); margin-bottom: 0.75rem; }
    p { font-size: 1.0625rem; line-height: 1.75rem; color: color(gray, 600); }
  }

  .denoise__panel {
    @include surface(var(--radius-2xl));
    padding: 1.25rem;

    @include up(md) { padding: 1.75rem; }
  }

  .denoise__legend {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem;
    font-size: 0.875rem; color: color(gray, 600); margin-bottom: 0.75rem;
  }

  .denoise__key {
    display: inline-flex; align-items: center; gap: 0.5rem;
    &::before { content: ''; width: 1.25rem; height: 3px; border-radius: 2px; background: currentColor; }
  }
  .denoise__key--noise { color: color(gray, 500); }
  .denoise__key--clean { color: color(red, 600); font-weight: 600; }

  .denoise__snr {
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    strong { color: color(gray, 900); display: inline-block; min-width: 4ch; text-align: right; }
  }

  .denoise__canvas { display: block; width: 100%; height: 14rem; @include up(md) { height: 18rem; } }

  .denoise__control {
    display: flex; align-items: center; gap: 1rem; margin-top: 1rem;
    font-size: 0.9375rem; font-weight: 600; color: color(gray, 800);

    input[type='range'] { flex: 1; accent-color: var(--c-red-600); cursor: pointer; }
    output {
      min-width: 3.5ch; text-align: right;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: color(gray, 600);
    }
  }
</style>
