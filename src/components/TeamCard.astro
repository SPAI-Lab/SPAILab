---
import type { CollectionEntry } from 'astro:content';
import Badge from './ui/Badge.astro';
import placeholder from '../assets/avatar-placeholder.svg';
import SocialLinks from './ui/SocialLinks.astro';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { name, role, avatar, avatarUrl, bio, email, website, linkedin, github, twitter, googleScholar } = member.data;
const profileUrl = `/team/${member.id.replace(/\.[^/.]+$/, "")}`;

// Hue mapping for title badges (cycled by index)
const badgeHues = ['blue', 'purple', 'emerald', 'amber', 'rose'] as const;
---

<div class="team-card">
  <!-- Avatar Container -->
  <div class="team-card__avatar">
    <a href={profileUrl} class="team-card__avatar-link">
      <img src={avatarUrl ?? (avatar ?? placeholder).src} alt={name} class="team-card__img" loading="lazy" />
    </a>

    <!-- Social Overlay (appears on hover) -->
    <div class="team-card__overlay">
      <div class="team-card__overlay-links">
        <SocialLinks variant="icon" {email} {website} {linkedin} {github} {twitter} {googleScholar} />
      </div>
    </div>
  </div>

  <!-- Info -->
  <a href={profileUrl} class="team-card__name-link">
    <h3 class="team-card__name">{name}</h3>
  </a>

  {member.data.title && member.data.title.length > 0 && (
    <div class="team-card__badges">
      {member.data.title.map((t, index) => (
        <Badge hue={badgeHues[index % badgeHues.length]}>{t}</Badge>
      ))}
    </div>
  )}

  {/* Role display removed as per request, relying on section headers and title badges */}

  {bio && <p class="team-card__bio">{bio}</p>}
</div>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .team-card__avatar {
    position: relative;
    width: 12rem;
    height: 12rem;
    margin-bottom: 1rem;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: color(gray, 100);
    transition: box-shadow 0.15s ease;
  }
  .team-card:hover .team-card__avatar { box-shadow: var(--shadow-lg); }

  .team-card__avatar-link { display: block; width: 100%; height: 100%; }

  .team-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .team-card:hover .team-card__img { transform: scale(1.05); }

  .team-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: rgb(0 0 0 / 0.2);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .team-card:hover .team-card__overlay { opacity: 1; }

  .team-card__overlay-links { pointer-events: auto; }

  .team-card__name-link {
    margin-bottom: 0.5rem;
    text-decoration-color: color(blue, 600);
    text-underline-offset: 2px;
    &:hover { text-decoration: underline; }
  }

  .team-card__name {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: color(gray, 900);
  }

  .team-card__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-inline: 0.5rem;
  }

  .team-card__bio {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: color(gray, 500);
    padding-inline: 0.5rem;
    @include line-clamp(2);
  }
</style>
