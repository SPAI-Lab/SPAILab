---
// Compact researcher card: photo, Korean name, English name, and email only.
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Mail } from 'lucide-react';
import { memberPhotoSrc } from '../lib/avatar';

interface Props {
  member: CollectionEntry<'team'>;
}

const { member } = Astro.props;
const { name, nameEn, email } = member.data;
const photo = memberPhotoSrc(member);
const profileUrl = url(`/team/${member.id.replace(/\.[^/.]+$/, '')}`);

---

<article class="card">
  <a href={profileUrl} class="card__photo" tabindex="-1" aria-hidden="true">
    <img src={photo} alt="" loading="lazy" />
  </a>

  <h3 class="card__name">
    <a href={profileUrl}>{name}</a>
    {nameEn && <span class="card__name-en">{nameEn}</span>}
  </h3>

  {email && (
    <a href={`mailto:${email}`} class="card__email">
      <Mail size={14} />
      <span>{email}</span>
    </a>
  )}

</article>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .card { display: flex; flex-direction: column; min-width: 0; }

  .card__photo {
    display: block; width: min(100%, 10rem); aspect-ratio: 3 / 4; overflow: hidden; margin-bottom: 1rem;
    border-radius: var(--radius-xl); background: color(gray, 50); transition: box-shadow 0.15s ease;
    img { width: 100%; height: 100%; object-fit: contain; }
  }
  .card:hover .card__photo { box-shadow: var(--shadow-md); }

  .card__name {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.125rem 0.5rem;
    font-size: 1.0625rem; line-height: 1.5; font-weight: 700; color: color(gray, 900);
    a:hover { color: color(accent, 600); }
  }
  .card__name-en { font-size: 0.8125rem; font-weight: 400; color: color(gray, 500); }

  .card__email {
    display: inline-flex; align-items: center; gap: 0.375rem; margin-top: 0.625rem; min-width: 0;
    font-size: 0.8125rem; color: color(gray, 600); transition: color 0.15s ease;
    svg { flex-shrink: 0; color: color(accent, 600); }
    span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    &:hover { color: color(accent, 600); text-decoration: underline; }
  }

</style>
