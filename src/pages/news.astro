---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const allNews = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="News">
  <Container size="narrow" padded>
    <PageHeader title="News & Updates" titleKey="news.title" />

    <div class="timeline">
      {allNews.map(item => (
        <div class="timeline__item">
          <span class="timeline__dot"></span>
          <time class="timeline__date">{item.data.date.toISOString().split('T')[0]}</time>
          <h2 class="timeline__title">{item.data.title}</h2>
          {item.data.summary && <p class="timeline__summary">{item.data.summary}</p>}
        </div>
      ))}

      {allNews.length === 0 && (
        <p class="timeline__empty" data-i18n-key="news.noNews">No news yet.</p>
      )}
    </div>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;

  .timeline {
    border-left: 2px solid color(gray, 100);
    padding-left: 2rem;
    > * + * { margin-top: 3rem; }
  }
  .timeline__item { position: relative; }
  .timeline__dot {
    position: absolute; left: -37px; top: 0.375rem;
    width: 1rem; height: 1rem; border-radius: var(--radius-full);
    background: color(blue, 100); border: 2px solid var(--c-white);
    box-shadow: 0 0 0 1px color(blue, 600);
  }
  .timeline__date { display: block; font-size: 0.875rem; line-height: 1.25rem; color: color(gray, 500); margin-bottom: 0.5rem; }
  .timeline__title { font-size: 1.25rem; line-height: 1.75rem; font-weight: 700; color: color(gray, 900); margin-bottom: 0.5rem; }
  .timeline__summary { color: color(gray, 600); margin-bottom: 1rem; }
  .timeline__empty { color: color(gray, 500); font-style: italic; }
</style>
