---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Calendar } from 'lucide-react';
import Container from '../../components/ui/Container.astro';
import BackLink from '../../components/ui/BackLink.astro';
import Prose from '../../components/ui/Prose.astro';

export async function getStaticPaths() {
  const activities = await getCollection('activities');
  return activities.map(activity => ({
    params: { slug: activity.id.replace(/\.[^/.]+$/, "") },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { Content } = await render(activity);
---

<Layout title={activity.data.title}>
  <Container size="narrow" padded>
    <article>
      <BackLink href="/activities">Back to Activities</BackLink>

      <header class="activity__header">
        <h1 class="activity__title">{activity.data.title}</h1>

        <div class="activity__meta">
          <Calendar size={16} />
          <time>{activity.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </div>

        {activity.data.cover && (
          <div class="activity__cover">
            <img src={activity.data.cover.src} alt={activity.data.title} />
          </div>
        )}

        {activity.data.description && (
          <p class="activity__description">
            {activity.data.description}
          </p>
        )}
      </header>

      <Prose>
        <Content />
      </Prose>
    </article>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .activity__header { margin-bottom: 3rem; }

  .activity__title {
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 700;
    color: color(gray, 900);
    margin-bottom: 1rem;
  }

  .activity__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: color(gray, 500);
    margin-bottom: 2rem;
  }

  .activity__cover {
    width: 100%;
    height: 16rem;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: color(gray, 100);
    margin-bottom: 2rem;

    @include up(sm) { height: 24rem; }

    img { width: 100%; height: 100%; object-fit: cover; }
  }

  .activity__description {
    font-size: 1.25rem;
    line-height: 1.625;
    color: color(gray, 600);
    border-left: 4px solid color(blue, 500);
    padding-left: 1rem;
    font-style: italic;
  }
</style>
