---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Calendar } from 'lucide-react';
import { SITE } from '../config';
import Container from '../components/ui/Container.astro';
import SectionHeaderLink from '../components/ui/SectionHeaderLink.astro';

const papers = (await getCollection('publications'))
  .filter(p => p.data.type === 'paper' && p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const activities = (await getCollection('activities'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <!-- Background Image -->
    <div class="hero__bg">
      {SITE.hero.image ? (
        <Image
          src={SITE.hero.image}
          alt={SITE.hero.title}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          quality={60}
          format="webp"
          widths={[640, 1024, 1920]}
          sizes="100vw"
        />
      ) : (
        <div class="hero__fallback"></div>
      )}
      <!-- Dark Gradient Overlay for Readability -->
      <div class="hero__overlay"></div>
      <!-- Subtle Texture (CSS only) -->
      <div class="hero__texture"></div>
    </div>

    <!-- Content -->
    <div class="hero__content">
      <Container>
        <div class="hero__inner">
          <h1 class="hero__title">
            <span>{SITE.hero.title}</span>
          </h1>
          <p class="hero__subtitle">
            {SITE.hero.subtitle}
          </p>
          <div class="hero__actions">
            <a href="/achievements" class="hero__btn hero__btn--primary" data-i18n-key="hero.viewPubs">
              View Publications
            </a>
            <a href="/team" class="hero__btn hero__btn--secondary" data-i18n-key="hero.meetTeam">
              Meet the Team
            </a>
          </div>
        </div>
      </Container>
    </div>

    <!-- Scroll Indicator -->
    <div class="hero__scroll">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Selected Publications -->
  <section class="section section--gray">
    <Container>
      <SectionHeaderLink title="Selected Publications" titleKey="section.selectedPubs" href="/achievements" />

      <div class="grid grid--pubs">
        {papers.map(paper => {
          const link = paper.data.links?.website || paper.data.links?.pdf || '/achievements';
          const isExternal = link.startsWith('http');
          return (
          <a
            href={link}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
            class="pub"
          >
             {paper.data.cover && (
               <div class="pub__cover">
                 <Image
                   src={paper.data.cover}
                   alt={paper.data.title}
                   quality={60}
                   format="webp"
                   widths={[320, 480]}
                   sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                 />
               </div>
             )}
             <div class="pub__body">
               <h3 class="pub__title">
                 {paper.data.title}
               </h3>
               <p class="pub__authors" title={paper.data.authors.join(', ')}>
                 {paper.data.authors.length > 3
                   ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.`
                   : paper.data.authors.join(', ')}
               </p>
               <div class="pub__meta">
                  <span class="pub__venue" title={paper.data.venue}>{paper.data.venue}</span>
                  <span class="pub__year">{paper.data.year}</span>
               </div>
             </div>
          </a>
        )})}
      </div>
    </Container>
  </section>

  <!-- Latest Activities -->
  <section class="section">
    <Container>
      <SectionHeaderLink title="Latest Activities" titleKey="section.latestNews" href="/activities" />

      <div class="grid grid--activities">
        {activities.map(item => {
          const link = `/activities/${item.id.replace(/\.[^/.]+$/, "")}`;
          return (
          <div class="activity">
            {item.data.cover && (
              <a href={link} class="activity__cover">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  quality={80}
                  format="webp"
                  widths={[320, 480, 600]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                />
              </a>
            )}
            <div class="activity__body">
              <div class="activity__date">
                 <Calendar size={16} />
                 {item.data.date.toLocaleDateString()}
              </div>
              <h3 class="activity__title">
                <a href={link}>{item.data.title}</a>
              </h3>
              <p class="activity__desc">{item.data.description || (item.body || '').substring(0, 100)}</p>
            </div>
          </div>
        )})}
      </div>
    </Container>
  </section>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  // ---- Hero ----
  .hero {
    position: relative; height: 100vh; min-height: 600px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0; z-index: 0;
    :global(img) { width: 100%; height: 100%; object-fit: cover; }
  }
  .hero__fallback { width: 100%; height: 100%; background: linear-gradient(to bottom right, color(gray, 900), color(gray, 800)); }
  .hero__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgb(0 0 0 / 0.9), rgb(0 0 0 / 0.5), transparent); }
  .hero__texture {
    position: absolute; inset: 0; opacity: 0.03;
    background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 32px 32px;
  }
  .hero__content { position: relative; z-index: 10; width: 100%; }
  .hero__inner { max-width: 48rem; }
  .hero__title {
    font-size: 3rem; line-height: 1.25; font-weight: 800; color: var(--c-white);
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 10px 8px rgb(0 0 0 / 0.04)) drop-shadow(0 4px 3px rgb(0 0 0 / 0.1));
    @include up(sm) { font-size: 3.75rem; }
    @include up(md) { font-size: 4.5rem; }
    span { display: block; @include up(xl) { display: inline; } }
  }
  .hero__subtitle {
    margin-top: 1rem; font-size: 1.25rem; line-height: 1.75rem; color: color(gray, 300);
    filter: drop-shadow(0 4px 3px rgb(0 0 0 / 0.07)) drop-shadow(0 2px 2px rgb(0 0 0 / 0.06));
    @include up(sm) { max-width: 42rem; }
    @include up(md) { font-size: 1.5rem; line-height: 2rem; }
  }
  .hero__actions { margin-top: 2.5rem; display: flex; gap: 1rem; }
  .hero__btn {
    display: flex; align-items: center; justify-content: center;
    padding: 1rem 2rem; font-size: 1.125rem; line-height: 1.75rem; font-weight: 500;
    border-radius: var(--radius-full); transition: all 0.3s ease;
  }
  .hero__btn--primary {
    border: 1px solid transparent; color: var(--c-black); background: var(--c-white);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    &:hover { background: color(gray, 100); box-shadow: 0 0 30px rgba(255, 255, 255, 0.5); }
  }
  .hero__btn--secondary {
    border: 2px solid rgb(255 255 255 / 0.3); color: var(--c-white); backdrop-filter: blur(4px);
    &:hover { background: rgb(255 255 255 / 0.1); }
  }
  .hero__scroll {
    position: absolute; bottom: 2rem; left: 50%;
    color: rgb(255 255 255 / 0.5); animation: hero-bounce 1s infinite;
  }
  @keyframes hero-bounce {
    0%, 100% { transform: translate(-50%, -25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }
    50% { transform: translate(-50%, 0); animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }
  }

  // ---- Sections ----
  .section { padding-block: 4rem; background: var(--c-white); }
  .section--gray { background: color(gray, 50); }
  .grid { display: grid; gap: 1.5rem; }
  .grid--pubs { @include up(md) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid--activities { gap: 2rem; @include up(md) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  // ---- Publication tile ----
  .pub {
    display: flex; flex-direction: column; height: 100%; overflow: hidden;
    background: var(--c-white); border: 1px solid color(gray, 100); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm); transition: all 0.15s ease;
    &:hover { box-shadow: var(--shadow-md); transform: translateY(-0.25rem); }
    &:hover .pub__title { color: color(blue, 600); }
    &:hover .pub__cover :global(img) { transform: scale(1.05); }
  }
  .pub__cover {
    height: 12rem; overflow: hidden; border-bottom: 1px solid color(gray, 100); background: color(gray, 50);
    :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  }
  .pub__body { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .pub__title {
    font-size: 1.125rem; line-height: 1.75rem; font-weight: 600; color: color(gray, 900);
    margin-bottom: 0.5rem; transition: color 0.15s ease; @include line-clamp(2);
  }
  .pub__authors {
    color: color(gray, 600); margin-bottom: 1rem; font-size: 0.875rem; line-height: 1.25rem;
    flex-grow: 1; @include line-clamp(2);
  }
  .pub__meta {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    font-size: 0.875rem; line-height: 1.25rem; margin-top: auto;
  }
  .pub__venue {
    display: block; max-width: 100%; text-align: left; font-weight: 500;
    color: color(blue, 600); background: color(blue, 50);
    padding: 0.25rem 0.5rem; border-radius: var(--radius-sm);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .pub__year { color: color(gray, 500); flex-shrink: 0; }

  // ---- Activity card ----
  .activity {
    background: var(--c-white); border: 1px solid color(gray, 100); border-radius: var(--radius-xl);
    overflow: hidden; transition: box-shadow 0.15s ease;
    &:hover { box-shadow: var(--shadow-lg); }
    &:hover .activity__title { color: color(blue, 600); }
    &:hover .activity__cover :global(img) { transform: scale(1.1); }
  }
  .activity__cover {
    display: block; height: 12rem; overflow: hidden;
    :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  }
  .activity__body { padding: 1.5rem; }
  .activity__date {
    font-size: 0.875rem; line-height: 1.25rem; color: color(gray, 500);
    margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;
  }
  .activity__title {
    font-size: 1.25rem; line-height: 1.75rem; font-weight: 700; color: color(gray, 900);
    margin-bottom: 0.5rem; transition: color 0.15s ease; @include line-clamp(2);
  }
  .activity__desc { color: color(gray, 600); font-size: 0.875rem; line-height: 1.25rem; @include line-clamp(3); }
</style>
