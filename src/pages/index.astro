---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Calendar, FlaskConical, BookOpen, Users, UserPlus, ArrowUpRight } from 'lucide-react';
import { SITE } from '../config';
import Container from '../components/ui/Container.astro';
import SectionHeaderLink from '../components/ui/SectionHeaderLink.astro';
import HeroWave from '../components/HeroWave.astro';

const allPubs = await getCollection('publications');
const allPapers = allPubs
  .filter(p => p.data.type === 'paper')
  .sort((a, b) => b.data.year - a.data.year);
// Featured papers first; if none are flagged, fall back to the latest ones.
const featured = allPapers.filter(p => p.data.featured);
const papers = (featured.length > 0 ? featured : allPapers).slice(0, 5);
const pubsTitle = featured.length > 0 ? { text: 'Selected Publications', key: 'section.selectedPubs' } : { text: 'Recent Publications', key: 'section.recentPubs' };
const teamCount = (await getCollection('team')).length;

const researchCount = (await getCollection('research')).length;

// Shortcut tiles under the hero (same idea as other CWNU lab sites); a tile with nothing behind it is dropped.
const tiles = [
  { href: '/research', Icon: FlaskConical, key: 'tile.research', title: 'Research', descKey: 'tile.researchDesc', desc: 'Research areas and topics', count: researchCount },
  { href: '/achievements', Icon: BookOpen, key: 'tile.papers', title: 'Publications', descKey: 'tile.papersDesc', desc: 'Journals and conference papers', count: allPapers.length },
  { href: '/team', Icon: Users, key: 'tile.team', title: 'Team', descKey: 'tile.teamDesc', desc: 'Professor and members', count: teamCount },
  { href: '/join', Icon: UserPlus, key: 'tile.join', title: 'Join Us', descKey: 'tile.joinDesc', desc: 'How to apply', count: 1 },
].filter(tile => tile.count > 0);

const activities = (await getCollection('activities'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <!-- Background: reactive waveform (echoes the lab logo) -->
    <div class="hero__bg">
      <HeroWave />
      <!-- Soft left fade keeps the headline readable over the bars -->
      <div class="hero__overlay"></div>
    </div>

    <!-- Content -->
    <div class="hero__content">
      <Container>
        <div class="hero__inner">
          <p class="hero__eyebrow" data-i18n-key="hero.eyebrow">{SITE.hero.eyebrow}</p>
          <h1 class="hero__title" aria-label={SITE.hero.title}>SP<span class="hero__amp">&amp;</span>AI</h1>
          <p class="hero__subtitle" data-i18n-key="hero.subtitle">
            {SITE.hero.subtitle}
          </p>
          <div class="hero__actions">
            <a href={url("/achievements")} class="hero__btn hero__btn--primary" data-i18n-key="hero.viewPubs">
              View Publications
            </a>
            <a href={url("/team")} class="hero__btn hero__btn--secondary" data-i18n-key="hero.meetTeam">
              Meet the Team
            </a>
          </div>
        </div>
      </Container>
    </div>
  </section>

  <!-- Shortcut tiles -->
  {tiles.length > 0 && (
  <section class="tiles">
    <Container>
      <ul class="tiles__grid">
        {tiles.map(({ href, Icon, key, title, descKey, desc }) => (
          <li>
            <a href={url(href)} class="tile">
              <span class="tile__icon"><Icon size={22} /></span>
              <span class="tile__text">
                <strong data-i18n-key={key}>{title}</strong>
                <small data-i18n-key={descKey}>{desc}</small>
              </span>
              <ArrowUpRight size={18} class="tile__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
  )}

  <!-- Publications -->
  {papers.length > 0 && (
  <section class="section section--gray">
    <Container>
      <SectionHeaderLink title={pubsTitle.text} titleKey={pubsTitle.key} href="/achievements" />

      <ul class="pubrows">
        {papers.map(paper => {
          const link = paper.data.links?.website || paper.data.links?.pdf || url('/achievements');
          const isExternal = link.startsWith('http');
          return (
            <li>
              <a
                href={link}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="pubrow"
              >
                <span class="pubrow__year">{paper.data.year}</span>
                <span class="pubrow__main">
                  <span class="pubrow__title">{paper.data.title}</span>
                  <span class="pubrow__meta" title={paper.data.authors.join(', ')}>
                    {paper.data.authors.length > 3
                      ? `${paper.data.authors.slice(0, 3).join(', ')}, et al.`
                      : paper.data.authors.join(', ')} · {paper.data.venue}
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </Container>
  </section>
  )}

  <!-- Latest Activities -->
  {activities.length > 0 && (
  <section class="section">
    <Container>
      <SectionHeaderLink title="Latest Activities" titleKey="section.latestActivities" href="/activities" />

      <div class="grid grid--activities">
        {activities.map(item => {
          const link = url(`/activities/${item.id.replace(/\.[^/.]+$/, "")}`);
          return (
          <div class="activity">
            {item.data.cover && (
              <a href={link} class="activity__cover">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  quality={80}
                  format="webp"
                  widths={[320, 480, 600]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                />
              </a>
            )}
            <div class="activity__body">
              <div class="activity__date">
                 <Calendar size={16} />
                 {item.data.date.toLocaleDateString()}
              </div>
              <h3 class="activity__title">
                <a href={link}>{item.data.title}</a>
              </h3>
              <p class="activity__desc">{item.data.description || (item.body || '').substring(0, 100)}</p>
            </div>
          </div>
        )})}
      </div>
    </Container>
  </section>
  )}
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  // ---- Hero ----
  .hero {
    position: relative; height: 100vh; min-height: 600px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0; z-index: 0;
    :global(img) { width: 100%; height: 100%; object-fit: cover; }
  }
  .hero__fallback { width: 100%; height: 100%; background: linear-gradient(to bottom right, color(gray, 900), color(gray, 800)); }
  .hero__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgb(10 10 13 / 0.85), rgb(10 10 13 / 0.35) 45%, transparent 70%); pointer-events: none; }
  .hero__texture {
    position: absolute; inset: 0; opacity: 0.03;
    background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 32px 32px;
  }
  .hero__content { position: relative; z-index: 10; width: 100%; }
  .hero__inner { max-width: 48rem; }
  .hero__eyebrow {
    margin-bottom: 1.25rem; font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: color(red, 400);
    &::before { content: ''; display: inline-block; width: 2rem; height: 2px; margin-right: 0.75rem; vertical-align: middle; background: currentColor; }
    @include up(sm) { font-size: 0.875rem; }
  }
  .hero__title {
    font-family: var(--font-mono); letter-spacing: -0.04em;
    font-size: clamp(3.5rem, 11vw, 7rem); line-height: 1; font-weight: 800; color: var(--c-white);
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 10px 8px rgb(0 0 0 / 0.04)) drop-shadow(0 4px 3px rgb(0 0 0 / 0.1));
    @include up(sm) { font-size: 3.75rem; }
    @include up(md) { font-size: 4.5rem; }
  }
  .hero__amp { color: color(red, 500); margin-inline: -0.03em; }
  .hero__subtitle {
    margin-top: 1rem; font-size: 1.25rem; line-height: 1.75rem; color: color(gray, 300);
    filter: drop-shadow(0 4px 3px rgb(0 0 0 / 0.07)) drop-shadow(0 2px 2px rgb(0 0 0 / 0.06));
    @include up(sm) { max-width: 42rem; }
    @include up(md) { font-size: 1.5rem; line-height: 2rem; }
  }
  .hero__actions { margin-top: 2.5rem; display: flex; gap: 1rem; }
  .hero__btn {
    display: flex; align-items: center; justify-content: center;
    padding: 1rem 2rem; font-size: 1.125rem; line-height: 1.75rem; font-weight: 500;
    border-radius: var(--radius-full); transition: all 0.3s ease;
  }
  .hero__btn--primary {
    border: 1px solid transparent; color: var(--c-white); background: color(red, 600);
    box-shadow: 0 0 24px rgb(220 38 38 / 0.45);
    &:hover { background: color(red, 500); box-shadow: 0 0 34px rgb(239 68 68 / 0.6); }
    &:focus-visible { outline: 3px solid var(--c-white); outline-offset: 3px; }
  }
  .hero__btn--secondary {
    border: 2px solid rgb(255 255 255 / 0.3); color: var(--c-white); backdrop-filter: blur(4px);
    &:hover { background: rgb(255 255 255 / 0.1); }
  }

  // ---- Shortcut tiles ----
  .tiles { background: var(--c-white); border-bottom: 1px solid color(gray, 200); }
  .tiles__grid {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; margin-top: -2.5rem; position: relative; z-index: 20;
    background: var(--c-white); border: 1px solid color(gray, 200); box-shadow: var(--shadow-md); border-radius: var(--radius-xl); overflow: hidden;
    @include up(sm) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @include up(lg) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    li { border-top: 1px solid color(gray, 100); &:first-child { border-top: 0; } }
    @include up(sm) { li:nth-child(-n+2) { border-top: 0; } }
    @include up(lg) { li { border-top: 0; border-left: 1px solid color(gray, 100); &:first-child { border-left: 0; } } }
    margin-bottom: 0;
  }
  .tile {
    display: flex; align-items: center; gap: 1rem; padding: 1.5rem; transition: background-color 0.15s ease;
    &:hover { background: color(gray, 50); }
    &:hover .tile__arrow { color: color(accent, 600); transform: translate(2px, -2px); }
    &:hover .tile__icon { background: color(accent, 600); color: var(--c-white); }
    &:focus-visible { outline: 2px solid color(accent, 600); outline-offset: -2px; }
  }
  .tile__icon {
    flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center;
    background: color(accent, 50); color: color(accent, 600); transition: all 0.15s ease;
  }
  .tile__text { flex: 1; min-width: 0; display: grid; strong { font-size: 1rem; color: color(gray, 900); } small { font-size: 0.8125rem; color: color(gray, 500); } }
  .tile__arrow { flex-shrink: 0; color: color(gray, 400); transition: all 0.15s ease; }

  // ---- Publication rows ----
  .pubrows { list-style: none; margin: 0; padding: 0; border-top: 1px solid color(gray, 200); }
  .pubrows li { border-bottom: 1px solid color(gray, 200); }
  .pubrow {
    display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.125rem 0.25rem; transition: background-color 0.15s ease;
    &:hover .pubrow__title { color: color(accent, 600); }
    &:focus-visible { outline: 2px solid color(accent, 600); outline-offset: -2px; }
  }
  .pubrow__year { font-family: var(--font-mono); font-size: 0.875rem; color: color(gray, 500); padding-top: 0.125rem; }
  .pubrow__main { display: grid; gap: 0.25rem; min-width: 0; }
  .pubrow__title { font-weight: 600; line-height: 1.5; color: color(gray, 900); transition: color 0.15s ease; }
  .pubrow__meta { font-size: 0.875rem; color: color(gray, 600); @include line-clamp(1); }

  // ---- Sections ----
  .section { padding-block: 4rem; background: var(--c-white); }
  .section--gray { background: color(gray, 50); }
  .grid { display: grid; gap: 1.5rem; }
  .grid--pubs { @include up(md) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid--activities { gap: 2rem; @include up(md) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  // ---- Publication tile ----
  .pub {
    display: flex; flex-direction: column; height: 100%; overflow: hidden;
    background: var(--c-white); border: 1px solid color(gray, 100); border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm); transition: all 0.15s ease;
    &:hover { box-shadow: var(--shadow-md); transform: translateY(-0.25rem); }
    &:hover .pub__title { color: color(accent, 600); }
    &:hover .pub__cover :global(img) { transform: scale(1.05); }
  }
  .pub__cover {
    height: 12rem; overflow: hidden; border-bottom: 1px solid color(gray, 100); background: color(gray, 50);
    :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  }
  .pub__body { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
  .pub__title {
    font-size: 1.125rem; line-height: 1.75rem; font-weight: 600; color: color(gray, 900);
    margin-bottom: 0.5rem; transition: color 0.15s ease; @include line-clamp(2);
  }
  .pub__authors {
    color: color(gray, 600); margin-bottom: 1rem; font-size: 0.875rem; line-height: 1.25rem;
    flex-grow: 1; @include line-clamp(2);
  }
  .pub__meta {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    font-size: 0.875rem; line-height: 1.25rem; margin-top: auto;
  }
  .pub__venue {
    display: block; max-width: 100%; text-align: left; font-weight: 500;
    color: color(accent, 600); background: color(accent, 50);
    padding: 0.25rem 0.5rem; border-radius: var(--radius-sm);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .pub__year { color: color(gray, 500); flex-shrink: 0; }

  // ---- Activity card ----
  .activity {
    background: var(--c-white); border: 1px solid color(gray, 100); border-radius: var(--radius-xl);
    overflow: hidden; transition: box-shadow 0.15s ease;
    &:hover { box-shadow: var(--shadow-lg); }
    &:hover .activity__title { color: color(accent, 600); }
    &:hover .activity__cover :global(img) { transform: scale(1.1); }
  }
  .activity__cover {
    display: block; height: 12rem; overflow: hidden;
    :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  }
  .activity__body { padding: 1.5rem; }
  .activity__date {
    font-size: 0.875rem; line-height: 1.25rem; color: color(gray, 500);
    margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;
  }
  .activity__title {
    font-size: 1.25rem; line-height: 1.75rem; font-weight: 700; color: color(gray, 900);
    margin-bottom: 0.5rem; transition: color 0.15s ease; @include line-clamp(2);
  }
  .activity__desc { color: color(gray, 600); font-size: 0.875rem; line-height: 1.25rem; @include line-clamp(3); }
</style>
