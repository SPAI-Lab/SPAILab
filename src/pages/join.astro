---
import Layout from '../layouts/Layout.astro';
import { Mail, Phone, MapPin } from 'lucide-react';
import { SITE } from '../config';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const contact = [
  { Icon: MapPin, text: SITE.address, key: 'footer.address' },
  ...SITE.locations.map(loc => ({ Icon: MapPin, text: loc.text, key: loc.key, sub: true })),
  { Icon: Phone, text: SITE.phone, href: `tel:${SITE.phone}` },
  { Icon: Mail, text: SITE.email, href: `mailto:${SITE.email}` },
] as Array<{ Icon: any; text: string; key?: string; href?: string; sub?: boolean }>;
---

<Layout title="Join Us">
  <Container padded>
    <PageHeader
      align="center"
      title="Join Us"
      titleKey="join.title"
      subtitle="We are looking for students to join our lab. If you are interested in our research areas, please contact us."
      subtitleKey="join.subtitle"
    />

    <section class="apply">
      <div class="apply__main">
        <h2 class="apply__title" data-i18n-key="join.howToApply">How to Apply</h2>
        <p class="apply__text" data-i18n-key="join.applicationText">
          Please send your CV, transcripts, and a brief statement of research interests to our Principal Investigator.
          Make sure to include "[Application]" in your email subject.
        </p>
        <a href={`mailto:${SITE.email}`} class="apply__btn">
          <Mail size={18} />
          <span data-i18n-key="join.sendEmail">Send Email</span>
        </a>
      </div>

      <ul class="apply__contact">
        {contact.map(({ Icon, text, key, href, sub }) => (
          <li class:list={{ 'is-sub': sub }}>
            <Icon size={16} />
            {href ? <a href={href}>{text}</a> : <span data-i18n-key={key}>{text}</span>}
          </li>
        ))}
      </ul>
    </section>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .apply {
    display: grid; gap: 2rem; padding: 2rem;
    border-radius: var(--radius-2xl); background: #232323; color: color(gray, 300);
    @include up(md) { grid-template-columns: 1.2fr 1fr; gap: 3rem; padding: 3rem; align-items: center; }
  }
  .apply__title { font-size: 1.5rem; line-height: 2rem; font-weight: 700; color: var(--c-white); margin-bottom: 0.75rem; }
  .apply__text { line-height: 1.7; margin-bottom: 1.75rem; word-break: keep-all; }
  .apply__btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: color(red, 600); color: var(--c-white);
    padding: 0.75rem 1.75rem; border-radius: var(--radius-full); font-weight: 600;
    transition: background-color 0.15s ease;
    &:hover { background: color(red, 500); }
    &:focus-visible { outline: 3px solid var(--c-white); outline-offset: 3px; }
  }

  .apply__contact {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 0.625rem; font-size: 0.9375rem; word-break: keep-all;
    li { display: flex; align-items: flex-start; gap: 0.75rem; }
    svg { flex-shrink: 0; margin-top: 0.3rem; color: color(red, 400); }
    .is-sub { padding-left: 1.75rem; svg { display: none; } }
    a:hover { color: var(--c-white); text-decoration: underline; }
  }
</style>
