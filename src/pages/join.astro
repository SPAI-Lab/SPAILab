---
import Layout from '../layouts/Layout.astro';
import { Mail, Phone, MapPin, GraduationCap, BookOpen, Code, Check } from 'lucide-react';
import { SITE } from '../config';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';

// Each role pulls its copy from the i18n dictionary (keys below); the English text is the fallback.
const roles = [
  {
    Icon: GraduationCap, key: 'join.phd', title: 'PhD Students',
    text: 'We are looking for PhD students with strong mathematical background and coding skills.',
    items: ['Strong math foundation', 'Proficient in Python/C++', 'Publication record is a plus'],
  },
  {
    Icon: BookOpen, key: 'join.master', title: 'Master Students',
    text: 'Motivated master students who want to dive deep into research are welcome.',
    items: ['Passion for research', 'Good programming skills', 'Commitment to projects'],
  },
  {
    Icon: Code, key: 'join.undergrad', title: 'Undergraduates',
    text: 'Talented undergraduates can join us for research training and internship.',
    items: ['Curiosity driven', 'Fast learner', 'Team player'],
  },
];

const contact = [
  { Icon: MapPin, text: SITE.address, key: 'footer.address' },
  ...SITE.locations.map(loc => ({ Icon: MapPin, text: loc.text, key: loc.key, sub: true })),
  { Icon: Phone, text: SITE.phone, href: `tel:${SITE.phone}` },
  { Icon: Mail, text: SITE.email, href: `mailto:${SITE.email}` },
] as Array<{ Icon: any; text: string; key?: string; href?: string; sub?: boolean }>;
---

<Layout title="Join Us">
  <Container padded>
    <PageHeader
      align="center"
      title="Join Us"
      titleKey="join.title"
      subtitle="We are always looking for motivated students to join our team. If you are interested in our research areas, please contact us!"
      subtitleKey="join.subtitle"
    />

    <div class="roles">
      {roles.map(({ Icon, key, title, text, items }) => (
        <article class="role">
          <div class="role__icon"><Icon size={22} /></div>
          <h3 class="role__title" data-i18n-key={key}>{title}</h3>
          <p class="role__text" data-i18n-key={`${key}Desc`}>{text}</p>
          <ul class="role__list">
            {items.map((item, i) => (
              <li>
                <Check size={16} />
                <span data-i18n-key={`${key}List${i + 1}`}>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <section class="apply">
      <div class="apply__main">
        <h2 class="apply__title" data-i18n-key="join.howToApply">How to Apply</h2>
        <p class="apply__text" data-i18n-key="join.applicationText">
          Please send your CV, transcripts, and a brief statement of research interests to our Principal Investigator.
          Make sure to include "[Application]" in your email subject.
        </p>
        <a href={`mailto:${SITE.email}`} class="apply__btn">
          <Mail size={18} />
          <span data-i18n-key="join.sendEmail">Send Email</span>
        </a>
      </div>

      <ul class="apply__contact">
        {contact.map(({ Icon, text, key, href, sub }) => (
          <li class:list={{ 'is-sub': sub }}>
            <Icon size={16} />
            {href ? <a href={href}>{text}</a> : <span data-i18n-key={key}>{text}</span>}
          </li>
        ))}
      </ul>
    </section>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .roles {
    display: grid; gap: 1.5rem; margin-bottom: 3rem;
    @include up(md) { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  }

  .role {
    @include surface(var(--radius-2xl));
    padding: 1.75rem; transition: box-shadow 0.15s ease, transform 0.15s ease;
    &:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  }
  .role__icon {
    width: 2.75rem; height: 2.75rem; border-radius: var(--radius-xl); margin-bottom: 1.25rem;
    display: flex; align-items: center; justify-content: center;
    background: color(red, 50); color: color(red, 600);
  }
  .role__title { font-size: 1.25rem; line-height: 1.75rem; font-weight: 700; color: color(gray, 900); margin-bottom: 0.5rem; }
  .role__text { color: color(gray, 600); font-size: 0.9375rem; line-height: 1.65; margin-bottom: 1.25rem; word-break: keep-all; }
  .role__list {
    list-style: none; margin: 0; padding: 1.25rem 0 0; border-top: 1px solid color(gray, 100);
    display: grid; gap: 0.625rem; font-size: 0.9375rem; color: color(gray, 700);
    li { display: flex; align-items: flex-start; gap: 0.625rem; }
    svg { flex-shrink: 0; margin-top: 0.25rem; color: color(red, 600); }
  }

  .apply {
    display: grid; gap: 2rem; padding: 2rem;
    border-radius: var(--radius-2xl); background: #232323; color: color(gray, 300);
    @include up(md) { grid-template-columns: 1.2fr 1fr; gap: 3rem; padding: 3rem; align-items: center; }
  }
  .apply__title { font-size: 1.5rem; line-height: 2rem; font-weight: 700; color: var(--c-white); margin-bottom: 0.75rem; }
  .apply__text { line-height: 1.7; margin-bottom: 1.75rem; word-break: keep-all; }
  .apply__btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: color(red, 600); color: var(--c-white);
    padding: 0.75rem 1.75rem; border-radius: var(--radius-full); font-weight: 600;
    transition: background-color 0.15s ease;
    &:hover { background: color(red, 500); }
    &:focus-visible { outline: 3px solid var(--c-white); outline-offset: 3px; }
  }

  .apply__contact {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 0.625rem; font-size: 0.9375rem; word-break: keep-all;
    li { display: flex; align-items: flex-start; gap: 0.75rem; }
    svg { flex-shrink: 0; margin-top: 0.3rem; color: color(red, 400); }
    .is-sub { padding-left: 1.75rem; svg { display: none; } }
    a:hover { color: var(--c-white); text-decoration: underline; }
  }
</style>
