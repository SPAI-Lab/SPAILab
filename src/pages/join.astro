---
import Layout from '../layouts/Layout.astro';
import { Mail, GraduationCap, BookOpen, Code } from 'lucide-react';
import { SITE } from '../config';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const roles = [
  {
    hue: 'blue', Icon: GraduationCap, title: 'PhD Students',
    text: 'We are looking for PhD students with strong mathematical background and coding skills.',
    items: ['Strong math foundation', 'Proficient in Python/C++', 'Publication record is a plus'],
  },
  {
    hue: 'green', Icon: BookOpen, title: 'Master Students',
    text: 'Self-motivated master students who want to dive deep into research are welcome.',
    items: ['Passion for research', 'Good programming skills', 'Commitment to projects'],
  },
  {
    hue: 'purple', Icon: Code, title: 'Undergraduates',
    text: 'Talented undergraduates can join us for research training and internship.',
    items: ['Curiosity driven', 'Fast learner', 'Team player'],
  },
];
---

<Layout title="Join Us">
  <Container size="narrow" padded>
    <PageHeader
      align="center"
      title="Join Us"
      titleKey="join.title"
      subtitle="We are always looking for motivated students to join our team. If you are interested in our research areas, please contact us!"
      subtitleKey="join.subtitle"
    />

    <div class="roles">
      {roles.map(({ hue, Icon, title, text, items }) => (
        <div class="role">
          <div class:list={['role__icon', `role__icon--${hue}`]}>
            <Icon size={24} />
          </div>
          <h3 class="role__title">{title}</h3>
          <p class="role__text">{text}</p>
          <ul class="role__list">
            {items.map(item => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="apply">
      <h2 class="apply__title" data-i18n-key="join.howToApply">How to Apply</h2>
      <p class="apply__text" data-i18n-key="join.applicationText">
        Please send your CV, transcripts, and a brief statement of research interests to our Principal Investigator.
        Make sure to include "[Application]" in your email subject.
      </p>

      <a href={`mailto:${SITE.email}`} class="apply__btn">
        <Mail size={20} />
        <span data-i18n-key="join.sendEmail">Send Email</span>
      </a>
    </div>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .roles {
    display: grid; gap: 2rem; margin-bottom: 4rem;
    @include up(md) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .role {
    @include surface(var(--radius-2xl));
    padding: 1.5rem; box-shadow: var(--shadow-sm);
    transition: box-shadow 0.15s ease;
    &:hover { box-shadow: var(--shadow-md); }
  }
  .role__icon {
    width: 3rem; height: 3rem; border-radius: var(--radius-xl);
    display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;
  }
  @each $hue in (blue, green, purple) {
    .role__icon--#{$hue} { background: color($hue, 50); color: color($hue, 600); }
  }
  .role__title { font-size: 1.25rem; line-height: 1.75rem; font-weight: 700; color: color(gray, 900); margin-bottom: 0.5rem; }
  .role__text { color: color(gray, 600); font-size: 0.875rem; line-height: 1.25rem; margin-bottom: 1rem; }
  .role__list {
    font-size: 0.875rem; line-height: 1.25rem; color: color(gray, 600);
    list-style: disc inside;
    li + li { margin-top: 0.5rem; }
  }

  .apply {
    background: color(gray, 50); border-radius: 1.5rem; padding: 2rem; text-align: center;
    @include up(sm) { padding: 3rem; }
  }
  .apply__title { font-size: 1.5rem; line-height: 2rem; font-weight: 700; color: color(gray, 900); margin-bottom: 1rem; }
  .apply__text { color: color(gray, 600); margin-bottom: 2rem; max-width: 42rem; margin-inline: auto; }
  .apply__btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: color(blue, 600); color: var(--c-white);
    padding: 0.75rem 2rem; border-radius: var(--radius-full); font-weight: 500;
    transition: background-color 0.15s ease;
    &:hover { background: color(blue, 700); }
  }
</style>
