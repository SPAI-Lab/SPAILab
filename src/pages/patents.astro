---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ScrollText } from 'lucide-react';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import EmptyState from '../components/ui/EmptyState.astro';

const patents = (await getCollection('patents')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Patents">
  <Container size="narrow" padded>
    <PageHeader
      title="Patents"
      titleKey="nav.patents"
      subtitle="Our intellectual property contributions and technological innovations."
    />

    <div class="patents">
      {patents.map(patent => (
        <div class="patent">
          <div class="patent__icon">
            <ScrollText size={24} />
          </div>

          <div class="patent__main">
            <div class="patent__head">
              <h3 class="patent__title">{patent.data.title}</h3>
              <StatusBadge status={patent.data.status} />
            </div>

            <div class="patent__inventors">
              <span class="patent__label">Inventors:</span> {patent.data.inventors.join(', ')}
            </div>

            <div class="patent__meta">
              <span class="patent__number">{patent.data.number}</span>
              <time>{patent.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            </div>
          </div>
        </div>
      ))}

      {patents.length === 0 && <EmptyState message="No patents listed yet." />}
    </div>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .patents > * + * { margin-top: 1.5rem; }
  .patent {
    @include surface;
    display: flex; align-items: flex-start; gap: 1rem; padding: 1.5rem;
    transition: box-shadow 0.15s ease;
    &:hover { box-shadow: var(--shadow-sm); }
  }
  .patent__icon {
    display: flex; flex-shrink: 0; padding: 0.75rem;
    background: color(blue, 50); color: color(blue, 600); border-radius: var(--radius-lg);
  }
  .patent__main { flex-grow: 1; }
  .patent__head {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    gap: 0.5rem; margin-bottom: 0.5rem;
  }
  .patent__title { font-size: 1.125rem; line-height: 1.75rem; font-weight: 700; color: color(gray, 900); }
  .patent__inventors { font-size: 0.875rem; line-height: 1.25rem; color: color(gray, 600); margin-bottom: 0.75rem; }
  .patent__label { font-weight: 500; color: color(gray, 900); }
  .patent__meta { display: flex; align-items: center; gap: 1rem; font-size: 0.875rem; line-height: 1.25rem; color: color(gray, 500); }
  .patent__number {
    font-family: var(--font-mono); background: color(gray, 50);
    padding: 0.125rem 0.5rem; border-radius: var(--radius-sm); border: 1px solid color(gray, 200);
  }
</style>
