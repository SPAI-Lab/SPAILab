---
import Layout from '../layouts/Layout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import { extractKeywords } from '../lib/keywords';

const allPapers = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const years = [...new Set(allPapers.map(p => p.data.year))];

// Keywords per paper (frontmatter + auto-detected) and their counts for the filter chips
const keywordsOf = (p: (typeof allPapers)[number]) =>
  extractKeywords(p.data.title, p.data.venue, p.data.keywords);
const counts = new Map<string, number>();
allPapers.forEach(p => keywordsOf(p).forEach(k => counts.set(k, (counts.get(k) ?? 0) + 1)));
const chips = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title="Publications">
  <Container size="narrow" padded>
    <PageHeader
      title="Publications"
      subtitle="A collection of our research papers, conference proceedings, and journal articles."
    />

    <div class="filter" id="pub-filter">
      <input
        id="pub-query"
        class="filter__input"
        type="search"
        placeholder="키워드, 제목, 저자, 학술지로 검색 (예: sonar, 딥러닝, Seok)"
        aria-label="Search publications"
        autocomplete="off"
      />
      <div class="filter__chips">
        {chips.map(([keyword, count]) => (
          <button type="button" class="chip" data-keyword={keyword} aria-pressed="false">
            {keyword} <span class="chip__count">{count}</span>
          </button>
        ))}
      </div>
      <p class="filter__status" id="pub-status" aria-live="polite"></p>
    </div>

    <div class="years">
      {years.map(year => (
        <div class="year" data-year-block>
          <div class="year__heading">
            <h2>{year}</h2>
          </div>
          <div class="year__list">
            {allPapers.filter(p => p.data.year === year).map(paper => (
              <div
                class="pub-wrap"
                data-pub
                data-keywords={JSON.stringify(keywordsOf(paper))}
                data-text={[paper.data.title, paper.data.authors.join(' '), paper.data.venue, paper.data.year].join(' ').toLowerCase()}
              >
                <PublicationItem entry={paper} />
              </div>
            ))}
          </div>
        </div>
      ))}

      {allPapers.length === 0 && (
        <EmptyState message="No publications found. Add markdown files to src/content/publications/" />
      )}
    </div>
    <p class="none" id="pub-none" hidden>검색 결과가 없습니다.</p>
  </Container>
</Layout>

<script>
  const query = document.getElementById('pub-query') as HTMLInputElement | null;
  const status = document.getElementById('pub-status');
  const none = document.getElementById('pub-none');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const pubs = [...document.querySelectorAll<HTMLElement>('[data-pub]')];
  const blocks = [...document.querySelectorAll<HTMLElement>('[data-year-block]')];
  const active = new Set<string>();

  function apply() {
    const terms = (query?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const el of pubs) {
      const keywords: string[] = JSON.parse(el.dataset.keywords ?? '[]');
      const text = (el.dataset.text ?? '') + ' ' + keywords.join(' ').toLowerCase();
      // every selected chip AND every typed term must match
      const ok =
        [...active].every(k => keywords.includes(k)) &&
        terms.every(t => text.includes(t));
      el.hidden = !ok;
      if (ok) shown++;
    }
    for (const b of blocks) {
      b.hidden = !b.querySelector('[data-pub]:not([hidden])');
    }
    const filtering = active.size > 0 || terms.length > 0;
    if (status) status.textContent = filtering ? `${shown} / ${pubs.length}편` : '';
    if (none) none.hidden = shown > 0;
  }

  query?.addEventListener('input', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const k = chip.dataset.keyword!;
      if (active.has(k)) active.delete(k); else active.add(k);
      chip.setAttribute('aria-pressed', String(active.has(k)));
      apply();
    });
  }
</script>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .filter { margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .filter__input {
    width: 100%; padding: 0.75rem 1rem; font-size: 1rem;
    border: 1px solid color(gray, 200); border-radius: var(--radius-xl); background: var(--c-white);
    &:focus { outline: none; box-shadow: 0 0 0 2px color(blue, 500); border-color: transparent; }
  }
  .filter__chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.25rem 0.75rem; font-size: 0.8125rem; font-weight: 500;
    color: color(gray, 600); background: color(gray, 50);
    border: 1px solid color(gray, 200); border-radius: var(--radius-full);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
    &:hover { background: color(blue, 50); color: color(blue, 600); }
    &[aria-pressed='true'] { background: color(blue, 600); color: var(--c-white); border-color: color(blue, 600); }
    &[aria-pressed='true'] .chip__count { color: color(blue, 100); }
  }
  .chip__count { font-size: 0.75rem; color: color(gray, 400); }
  .filter__status { font-size: 0.875rem; color: color(gray, 500); min-height: 1.25rem; }
  .none { text-align: center; padding-block: 3rem; color: color(gray, 500); }

  .years { display: flex; flex-direction: column; gap: 3rem; }
  .year { position: relative; }
  .year__heading {
    position: sticky; top: var(--header-height); z-index: 10;
    background: rgb(255 255 255 / 0.9); backdrop-filter: blur(8px);
    padding-block: 0.5rem; margin-bottom: 1rem; border-bottom: 1px solid color(gray, 100);
  }
  h2 { font-size: 1.5rem; line-height: 2rem; font-weight: 700; color: color(gray, 900); }
  .year__list { display: flex; flex-direction: column; gap: 0.5rem; }
  [hidden] { display: none !important; }
</style>
