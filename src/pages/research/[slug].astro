---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Container from '../../components/ui/Container.astro';
import BackLink from '../../components/ui/BackLink.astro';
import Prose from '../../components/ui/Prose.astro';

export async function getStaticPaths() {
  const researchAreas = await getCollection('research');
  return researchAreas.map(area => ({
    params: { slug: area.id.replace(/\.[^/.]+$/, "") },
    props: { area },
  }));
}

const { area } = Astro.props;
const { Content } = await render(area);
---

<Layout title={area.data.title}>
  <Container size="narrow" padded>
    <article>
      <BackLink href="/research">Back to Research</BackLink>

      <header class="article__header">
        <h1 class="article__title">{area.data.title}</h1>
        {area.data.cover && (
          <div class="article__cover">
            <img src={area.data.cover.src} alt={area.data.title} />
          </div>
        )}
        <p class="article__lead">{area.data.description}</p>
      </header>

      <Prose>
        <Content />
      </Prose>
    </article>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .article__header { margin-bottom: 3rem; }
  .article__title { font-size: 2.25rem; line-height: 2.5rem; font-weight: 700; color: color(gray, 900); margin-bottom: 1.5rem; }
  .article__cover {
    width: 100%; height: 16rem; border-radius: var(--radius-2xl); overflow: hidden;
    background: color(gray, 100); margin-bottom: 2rem;
    @include up(sm) { height: 24rem; }
    img { width: 100%; height: 100%; object-fit: cover; }
  }
  .article__lead { font-size: 1.25rem; line-height: 1.625; color: color(gray, 600); }
</style>
