---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Calendar } from 'lucide-react';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';

const activities = (await getCollection('activities')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Activities">
  <Container padded>
    <div class="activities__header">
      <PageHeader
        title="Team Activities"
        titleKey="activities.title"
        subtitle="Workshops, seminars, and team building events."
        subtitleKey="activities.subtitle"
      />
    </div>

    <!-- Activities Gallery -->
    <h2 class="activities__heading" data-i18n-key="nav.activities">Activities</h2>
    <div class="activities__grid">
      {activities.map(activity => (
        <a href={url(`/activities/${activity.id.replace(/\.[^/.]+$/, "")}`)} class="activity-card">
          {activity.data.cover && (
            <div class="activity-card__media">
              <Image
                src={activity.data.cover}
                alt={activity.data.title}
                quality={80}
                format="webp"
                width={600}
              />
              <div class="activity-card__date">
                <Calendar size={16} />
                <time>{activity.data.date.toISOString().split('T')[0]}</time>
              </div>
            </div>
          )}
          <div class="activity-card__body">
            <h3 class="activity-card__title">{activity.data.title}</h3>
            <p class="activity-card__desc">{activity.data.description}</p>
          </div>
        </a>
      ))}
      {activities.length === 0 && (
        <div class="activities__empty">
          <EmptyState message="No activities added yet." i18nKey="activities.noActivities" />
        </div>
      )}
    </div>

    <!-- News List -->
    <h2 class="activities__heading" data-i18n-key="section.latestNews">Latest News</h2>
    <div class="news">
      {news.map(item => (
        <div class="news__item">
          <span class="news__dot"></span>
          <time class="news__date">{item.data.date.toISOString().split('T')[0]}</time>
          <h3 class="news__title">{item.data.title}</h3>
          {item.data.summary && <p class="news__summary">{item.data.summary}</p>}
        </div>
      ))}
    </div>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .activities__header { margin-bottom: 1rem; }

  .activities__heading {
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 700;
    color: color(gray, 900);
    margin-bottom: 2rem;
  }

  .activities__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 5rem;

    @include up(md) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @include up(lg) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .activities__empty { grid-column: 1 / -1; }

  .activity-card {
    @include surface(var(--radius-2xl));
    display: block;
    overflow: hidden;
    transition: all 0.15s ease;

    &:hover { box-shadow: var(--shadow-lg); }
    &:hover .activity-card__media :global(img) { transform: scale(1.05); }
    &:hover .activity-card__title { color: color(blue, 600); }
  }

  .activity-card__media {
    position: relative;
    height: 14rem;
    overflow: hidden;
    background: color(gray, 100);

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
  }

  .activity-card__date {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgb(0 0 0 / 0.3);
    backdrop-filter: blur(4px);
    color: rgb(255 255 255 / 0.9);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .activity-card__body { padding: 1.5rem; }

  .activity-card__title {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 700;
    color: color(gray, 900);
    margin-bottom: 0.5rem;
    transition: color 0.15s ease;
  }

  .activity-card__desc {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: color(gray, 600);
    @include line-clamp(3);
  }

  .news {
    max-width: 48rem;
    padding-left: 2rem;
    border-left: 2px solid color(gray, 100);

    > * + * { margin-top: 3rem; }
  }

  .news__item { position: relative; }

  .news__dot {
    position: absolute;
    left: -37px;
    top: 0.375rem;
    width: 1rem;
    height: 1rem;
    border-radius: var(--radius-full);
    background: color(blue, 100);
    border: 2px solid var(--c-white);
    box-shadow: 0 0 0 1px color(blue, 600);
  }

  .news__date {
    display: block;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: color(gray, 500);
    margin-bottom: 0.5rem;
  }

  .news__title {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 700;
    color: color(gray, 900);
    margin-bottom: 0.5rem;
  }

  .news__summary { color: color(gray, 600); }
</style>
