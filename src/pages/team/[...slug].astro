---
import placeholder from '../../assets/avatar-placeholder.svg';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import Container from '../../components/ui/Container.astro';
import BackLink from '../../components/ui/BackLink.astro';
import SocialLinks from '../../components/ui/SocialLinks.astro';
import Prose from '../../components/ui/Prose.astro';

export async function getStaticPaths() {
  const teamMembers = await getCollection('team');
  return teamMembers.map(member => ({
    params: { slug: member.id.replace(/\.[^/.]+$/, "") },
    props: { member },
  }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const { name, role, title, avatar, avatarUrl, email, website, linkedin, github, twitter, googleScholar } = member.data;

const roleToKey = {
  'Principal Investigator': 'team.pi',
  'Professor': 'team.professor',
  'Teacher': 'team.teacher',
  'Postdoctoral Researcher': 'team.postdoc_researcher',
  'Postdoc': 'team.postdoc',
  'PhD Student': 'team.phd',
  'Master Student': 'team.master',
  'Graduate Student': 'team.graduate',
  'Undergraduate': 'team.undergrad',
  'Former Member': 'team.former'
};
---

<Layout title={name}>
  <Container size="narrow" padded>
    <BackLink href="/team">Back to Team</BackLink>

    <div class="member">
      <div class="member__inner">
        <div class="member__avatar">
          <img src={avatarUrl ?? (avatar ?? placeholder).src} alt={name} />
        </div>

        <div class="member__info">
          <h1 class="member__name">{name}</h1>
          <p class="member__role">{role}</p>

          <SocialLinks variant="pill" {email} {website} {linkedin} {github} {twitter} {googleScholar} />

          {title && title.length > 0 && (
            <div class="member__tags">
              {title.map((t) => (
                <span class="member__tag">{t}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <Prose>
      <Content />
    </Prose>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .member {
    @include surface(1.5rem);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 3rem;
  }

  .member__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;

    @include up(md) { flex-direction: row; }
  }

  .member__avatar {
    width: 8rem;
    height: 8rem;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: color(gray, 100);
    flex-shrink: 0;
    margin-inline: auto;

    @include up(md) {
      width: 12rem;
      height: 12rem;
      margin-inline: 0;
    }

    img { width: 100%; height: 100%; object-fit: cover; }
  }

  .member__info {
    flex-grow: 1;
    text-align: center;
    @include up(md) { text-align: left; }
  }

  .member__name {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    color: color(gray, 900);
    margin-bottom: 0.5rem;
  }

  .member__role {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: color(blue, 600);
    margin-bottom: 1.5rem;
  }

  .member__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    @include up(md) { justify-content: flex-start; }
  }

  .member__tag {
    background: color(blue, 100);
    color: color(blue, 800);
    font-size: 0.75rem;
    line-height: 1rem;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-sm);
    border: 1px solid color(blue, 200);
  }
</style>
