---
import { memberPhotoSrc } from '../../lib/avatar';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Container from '../../components/ui/Container.astro';
import BackLink from '../../components/ui/BackLink.astro';
import PublicationItem from '../../components/PublicationItem.astro';
import PatentCard from '../../components/ui/PatentCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { BookOpen, GraduationCap, Mail, ScrollText } from 'lucide-react';

export async function getStaticPaths() {
  const teamMembers = await getCollection('team');
  return teamMembers.map(member => ({
    params: { slug: member.id.replace(/\.[^/.]+$/, "") },
    props: { member },
  }));
}

const { member } = Astro.props;
const photo = memberPhotoSrc(member);
const { name, nameEn, email, googleScholar } = member.data;
const isProfessor = member.id.replace(/\.[^/.]+$/, '') === 'prof-seok-jongwon';
const publications = (await getCollection('publications'))
  .filter((entry) => isProfessor || (nameEn && entry.data.authors.includes(nameEn)))
  .sort((a, b) => b.data.year - a.data.year);
const patents = isProfessor
  ? (await getCollection('patents')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : [];
---

<Layout title={name}>
  <Container size="narrow" padded>
    <BackLink href="/team"><span data-i18n-key="team.back">Back to Team</span></BackLink>

    <div class="member">
      <div class="member__inner">
        <div class="member__avatar">
          <img src={photo} alt={name} />
        </div>

        <div class="member__info">
          <h1 class="member__name">{name}</h1>
          {nameEn && <p class="member__name-en">{nameEn}</p>}
          {email && (
            <ul class="member__contact">
              <li><Mail size={16} /><a href={`mailto:${email}`}>{email}</a></li>
              {googleScholar && (
                <li>
                  <GraduationCap size={16} />
                  <a href={googleScholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
                </li>
              )}
            </ul>
          )}
        </div>
      </div>
    </div>

    {publications.length > 0 && (
      <section class="member__achievements">
        <SectionHeading icon={BookOpen} title={`Publications (${publications.length})`} />
        <div class="member__publication-list">
          {publications.map((publication) => <PublicationItem entry={publication} />)}
        </div>
      </section>
    )}

    {patents.length > 0 && (
      <section class="member__achievements">
        <SectionHeading icon={ScrollText} title={`Patents (${patents.length})`} />
        <div class="member__patent-list">
          {patents.map((patent) => (
            <PatentCard
              title={patent.data.title}
              titleEn={patent.data.titleEn}
              inventors={patent.data.inventors}
              number={patent.data.number}
              date={patent.data.date}
              status={patent.data.status}
              assignee={patent.data.assignee}
            />
          ))}
        </div>
      </section>
    )}

  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .member {
    @include surface(1.5rem);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 3rem;
  }

  .member__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;

    @include up(md) { flex-direction: row; }
  }

  .member__avatar {
    width: 8rem;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: color(gray, 100);
    flex-shrink: 0;
    margin-inline: auto;

    @include up(md) {
      width: 10rem;
      margin-inline: 0;
    }

    img { width: 100%; height: 100%; object-fit: contain; }
  }

  .member__info {
    flex-grow: 1;
    text-align: center;
    @include up(md) { text-align: left; }
  }

  .member__name {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 700;
    color: color(gray, 900);
    margin-bottom: 0.5rem;
  }

  .member__name-en {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: color(accent, 600);
    margin-bottom: 1.5rem;
  }

.member__contact {
    list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.25rem; font-size: 0.9375rem; color: color(gray, 700);
    li { display: flex; align-items: center; gap: 0.5rem; }
    svg { color: color(accent, 600); }
    a:hover { color: color(accent, 600); text-decoration: underline; }
  }

  .member__achievements { margin-top: 3.5rem; }
  .member__publication-list {
    border-top: 1px solid color(gray, 200);
    > :global(*) { border-bottom: 1px solid color(gray, 200); }
  }
  .member__patent-list { display: grid; gap: 1rem; }
</style>
