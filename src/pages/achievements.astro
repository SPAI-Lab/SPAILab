---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PublicationItem from '../components/PublicationItem.astro';
import BookItem from '../components/BookItem.astro';
import HonorCard from '../components/HonorCard.astro';
import Container from '../components/ui/Container.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import SoftwareCard from '../components/ui/SoftwareCard.astro';
import PatentCard from '../components/ui/PatentCard.astro';
import { Book, FileCode, ScrollText, Award, BookOpen } from 'lucide-react';

// Fetch Collections
const papers = (await getCollection('publications'))
  .filter(p => p.data.type === 'paper')
  .sort((a, b) => b.data.year - a.data.year);
const books = (await getCollection('books'))
  .sort((a, b) => b.data.year - a.data.year);

const softwares = (await getCollection('softwares'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const patents = (await getCollection('patents'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const honors = (await getCollection('honors'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sections = [
  { id: 'papers', title: 'Published Papers', key: 'achievements.papers', icon: BookOpen, count: papers.length },
  { id: 'books', title: 'Book Chapters', key: 'achievements.books', icon: Book, count: books.length },
  { id: 'softwares', title: 'Software Copyrights', key: 'achievements.softwares', icon: FileCode, count: softwares.length },
  { id: 'patents', title: 'Invention Patents', key: 'achievements.patents', icon: ScrollText, count: patents.length },
  { id: 'honors', title: 'Group Honors', key: 'achievements.honors', icon: Award, count: honors.length },
];
---

<Layout title="Achievements">
  <Container padded>
    <PageHeader
      align="center"
      title="Research Achievements"
      titleKey="achievements.title"
      subtitle="A comprehensive collection of our academic publications, intellectual property, and collective honors."
      subtitleKey="achievements.subtitle"
    />

    <!-- Navigation Pills -->
    <nav class="pills">
      {sections.map(section => (
        <a href={`#${section.id}`} class="pill">
          <section.icon size={16} />
          <span data-i18n-key={section.key}>{section.title}</span>
          <span class="pill__count">{section.count}</span>
        </a>
      ))}
    </nav>

    <div class="sections">
      <!-- Papers -->
      <section id="papers">
        <SectionHeading icon={BookOpen} title="Published Papers" i18nKey="achievements.papers" />
        <div class="grid">
          {papers.map(paper => <PublicationItem entry={paper} />)}
          {papers.length === 0 && <EmptyState message="No papers listed yet." i18nKey="achievements.noPapers" />}
        </div>
      </section>

      <!-- Books -->
      <section id="books">
        <SectionHeading icon={Book} title="Book Chapters" i18nKey="achievements.books" />
        <div class="grid grid--4">
          {books.map(book => <BookItem entry={book} />)}
          {books.length === 0 && <EmptyState message="No book chapters listed yet." i18nKey="achievements.noBooks" />}
        </div>
      </section>

      <!-- Softwares -->
      <section id="softwares">
        <SectionHeading icon={FileCode} title="Software Copyrights" i18nKey="achievements.softwares" />
        <div class="grid grid--3">
          {softwares.map(software => (
            <SoftwareCard
              title={software.data.title}
              developers={software.data.developers}
              number={software.data.number}
              date={software.data.date}
            />
          ))}
          {softwares.length === 0 && <EmptyState message="No software copyrights listed yet." i18nKey="achievements.noSoftwares" />}
        </div>
      </section>

      <!-- Patents -->
      <section id="patents">
        <SectionHeading icon={ScrollText} title="Invention Patents" i18nKey="achievements.patents" />
        <div class="grid">
          {patents.map(patent => (
            <PatentCard
              title={patent.data.title}
              inventors={patent.data.inventors}
              number={patent.data.number}
              date={patent.data.date}
              status={patent.data.status}
            />
          ))}
          {patents.length === 0 && <EmptyState message="No patents listed yet." i18nKey="achievements.noPatents" />}
        </div>
      </section>

      <!-- Honors -->
      <section id="honors">
        <SectionHeading icon={Award} title="Group Honors" i18nKey="achievements.honors" />
        <div class="grid grid--3">
          {honors.map(honor => <HonorCard honor={honor} />)}
          {honors.length === 0 && <EmptyState message="No group honors listed yet." i18nKey="achievements.noHonors" />}
        </div>
      </section>
    </div>
  </Container>
</Layout>

<style lang="scss">
  @use 'tokens' as *;
  @use 'mixins' as *;

  .pills {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem;
    margin-bottom: 4rem; padding: 1rem;
    position: sticky; top: var(--header-height); z-index: 30;
    background: rgb(255 255 255 / 0.8); backdrop-filter: blur(8px);
    border-radius: var(--radius-2xl); border: 1px solid color(gray, 100); box-shadow: var(--shadow-sm);
  }
  .pill {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; border-radius: var(--radius-full);
    background: color(gray, 50); color: color(gray, 600);
    font-size: 0.875rem; line-height: 1.25rem; font-weight: 500;
    transition: background-color 0.15s, color 0.15s;
    &:hover { background: color(blue, 50); color: color(blue, 600); }
    :global(svg) { @include icon(1rem); }
  }
  .pill__count {
    background: var(--c-white); padding: 0.125rem 0.5rem; border-radius: var(--radius-full);
    font-size: 0.75rem; line-height: 1rem; color: color(gray, 400); box-shadow: var(--shadow-sm);
  }

  .sections { display: flex; flex-direction: column; gap: 6rem; }
  section { scroll-margin-top: 6rem; }

  .grid { display: grid; gap: 1.5rem; }
  .grid--3 { @include up(sm) { grid-template-columns: repeat(2, minmax(0, 1fr)); } @include up(lg) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid--4 { @include up(sm) { grid-template-columns: repeat(2, minmax(0, 1fr)); } @include up(lg) { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
